 	uint16_t format;
 	/* number of audio channels */
 	unsigned int channels;
+	/* Y2 encoder observations, never requested quality. Access via GLib
+	 * atomic integer operations across encoder and D-Bus threads. */
+	int encoder_active, encoder_bitrate_kbps, encoder_quality;
+	int encoder_bitpool, encoder_abr, encoder_adjustments, encoder_errors;
+
 	/* PCM sample rate */
 	unsigned int rate;
 
