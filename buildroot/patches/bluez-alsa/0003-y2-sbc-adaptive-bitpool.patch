--- /dev/null
+++ b/src/y2-sbc-abr.h
@@ -0,0 +1,84 @@
+/*
+ * Y2Linux: adaptive bit-pool for SBC, the counterpart of y2-aac-abr.h.
+ *
+ * SBC kept its full bit-pool (53 at 44.1 kHz joint stereo, ~328 kbit/s) on a
+ * weak link, so a sink with a poor radio ran dry and stuttered while others
+ * coped. This steps the bit-pool down (100%, 85%, 66%: 53 -> 45 -> 35) while
+ * the socket queue backs up and back up after a quiet stretch, never below
+ * the peer's negotiated minimum. libsbc applies a new bit-pool from the next
+ * frame on. Pure decisions, no I/O: unit-tested.
+ *
+ * This file is free software; you can redistribute it and/or modify it under
+ * the terms of the MIT license. See the COPYING file for details.
+ */
+#ifndef Y2_SBC_ABR_H_
+#define Y2_SBC_ABR_H_
+
+#include <stdbool.h>
+
+#define Y2_SBC_ABR_LEVELS 3
+/* Never step twice within this time (as for AAC). */
+#define Y2_SBC_ABR_HOLD_MS 200
+/* Time with an empty socket queue before stepping up. */
+#define Y2_SBC_ABR_CALM_MS 10000
+
+struct y2_sbc_abr {
+	bool enabled;
+	unsigned int level;
+	unsigned int levels;
+	unsigned int bitpools[Y2_SBC_ABR_LEVELS];
+	/* both counted in PCM frames, so packet size does not matter */
+	unsigned int hold, calm_needed;
+	unsigned int calm, since_change;
+};
+
+static inline void y2_sbc_abr_init(struct y2_sbc_abr *abr, unsigned int bitpool,
+		unsigned int min_bitpool, unsigned int rate, bool enabled) {
+	static const unsigned int percent[Y2_SBC_ABR_LEVELS] = { 100, 85, 66 };
+	abr->level = abr->levels = abr->calm = abr->since_change = 0;
+	for (unsigned int i = 0; i < Y2_SBC_ABR_LEVELS; i++) {
+		unsigned int value = (bitpool * percent[i] + 50) / 100;
+		if (value < min_bitpool)
+			value = min_bitpool < bitpool ? min_bitpool : bitpool;
+		/* Levels the peer's minimum folds together are dropped. */
+		if (abr->levels == 0 || value < abr->bitpools[abr->levels - 1])
+			abr->bitpools[abr->levels++] = value;
+	}
+	abr->hold = rate * Y2_SBC_ABR_HOLD_MS / 1000;
+	abr->calm_needed = rate * (Y2_SBC_ABR_CALM_MS / 1000);
+	/* Nothing to adapt when every level is the same bit-pool. */
+	abr->enabled = enabled && abr->levels > 1;
+}
+
+/* Call once per written packet with the socket queue depth (in packets)
+ * seen before writing it, whether the write had to wait and the PCM frames
+ * it carried. Returns the new bit-pool when the level changes, otherwise 0. */
+static inline unsigned int y2_sbc_abr_update(struct y2_sbc_abr *abr,
+		unsigned int queued_packets, bool blocked, unsigned int pcm_frames) {
+	if (!abr->enabled)
+		return 0;
+	if (abr->since_change < abr->hold)
+		abr->since_change += pcm_frames;
+	if (blocked || queued_packets >= 2) {
+		abr->calm = 0;
+		if (abr->level + 1 < abr->levels && abr->since_change >= abr->hold) {
+			abr->level++;
+			abr->since_change = 0;
+			return abr->bitpools[abr->level];
+		}
+		return 0;
+	}
+	if (queued_packets != 0)
+		abr->calm = 0;
+	else if (abr->calm < abr->calm_needed)
+		abr->calm += pcm_frames;
+	if (abr->level > 0 && abr->calm >= abr->calm_needed) {
+		abr->level--;
+		abr->calm = 0;
+		abr->since_change = 0;
+		return abr->bitpools[abr->level];
+	}
+	return 0;
+}
+
+#endif
