#!/bin/sh
case "$1" in
 start)
    (
      until ip link show usb0 >/dev/null 2>&1; do sleep 1; done
      ip address replace 10.42.0.1/24 dev usb0
      ip link set usb0 up
      echo 'Y2NET: usb0 10.42.0.1/24 ready; address persists across cable reconnect' > /dev/kmsg
    ) &
    ;;
 stop) ip link set usb0 down 2>/dev/null;;
esac
