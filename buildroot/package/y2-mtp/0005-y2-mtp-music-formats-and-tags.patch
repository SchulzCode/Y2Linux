+// Y2: ObjectFormat of an entry (music by file extension).
+static uint16_t entry_format(fs_entry * entry)
+{
+	return y2_object_format(entry->name, entry->flags & ENTRY_IS_DIR);
+}
+
+// Y2: tags of a music entry. 0: not a music file (tags untouched).
+static int entry_tags(mtp_ctx * ctx, fs_entry * entry, const char * path, y2_tags * tags)
+{
+	char * full_path;
+
+	if( !y2_format_is_audio(entry_format(entry)) )
+		return 0;
+
+	full_path = NULL;
+	if( !path )
+	{
+		full_path = build_full_path(ctx->fs_db, mtp_get_storage_root(ctx, entry->storage_id), entry);
+		path = full_path;
+	}
+
+	y2_tags_get(path, entry->name, tags);
+
+	if( full_path )
+		free(full_path);
+
+	return 1;
+}
+
+// Y2: music tag properties, in the order GetObjectPropList reports them.
+static const uint16_t tag_properties[] =
+{
+	MTP_PROPERTY_ARTIST, MTP_PROPERTY_ALBUM_NAME, MTP_PROPERTY_ALBUM_ARTIST, MTP_PROPERTY_TRACK,
+	MTP_PROPERTY_ORIGINAL_RELEASE_DATE, MTP_PROPERTY_DURATION, MTP_PROPERTY_GENRE, MTP_PROPERTY_COMPOSER,
+	MTP_PROPERTY_AUDIO_BITRATE, MTP_PROPERTY_NUMBER_OF_CHANNELS, MTP_PROPERTY_SAMPLE_RATE,
+	0xFFFF
+};
+
+static int is_tag_property(uint32_t prop_code)
+{
+	int i;
+
+	for( i = 0; tag_properties[i] != 0xFFFF; i++ )
+	{
+		if( tag_properties[i] == prop_code )
+			return 1;
+	}
+
+	return 0;
+}
+
+// Y2: value of a music tag property (data type as in properties[]), and its address for objectproplist_element().
+static void * tag_value(y2_tags * tags, uint32_t prop_code, uint16_t * u16, uint32_t * u32)
+{
+	switch(prop_code)
+	{
+		case MTP_PROPERTY_ARTIST:                return tags->artist;
+		case MTP_PROPERTY_ALBUM_NAME:            return tags->album;
+		case MTP_PROPERTY_ALBUM_ARTIST:          return tags->album_artist;
+		case MTP_PROPERTY_GENRE:                 return tags->genre;
+		case MTP_PROPERTY_TRACK:                 *u16 = tags->track; return u16;
+		case MTP_PROPERTY_NUMBER_OF_CHANNELS:    *u16 = tags->channels; return u16;
+		case MTP_PROPERTY_DURATION:              *u32 = tags->duration_ms; return u32;
+		case MTP_PROPERTY_SAMPLE_RATE:           *u32 = tags->sample_rate; return u32;
+		case MTP_PROPERTY_AUDIO_BITRATE:         *u32 = tags->bitrate; return u32;
+		default:                                 return "";       // Composer, OriginalReleaseDate: not in the library
+	}
+}
+
+static int poke_tag(void * buffer, int ofs, int maxsize, y2_tags * tags, uint32_t prop_code)
+{
+	uint16_t u16;
+	uint32_t u32;
+	void * value;
+
+	value = tag_value(tags, prop_code, &u16, &u32);
+
+	if( value == &u16 )
+		return poke16(buffer, ofs, maxsize, u16);
+	if( value == &u32 )
+		return poke32(buffer, ofs, maxsize, u32);
+
+	return poke_string(buffer, ofs, maxsize, (char*)value);
+}
