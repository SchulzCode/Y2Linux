diff --git a/src/y2_tags.c b/src/y2_tags.c
new file mode 100644
index 0000000..b4594a5
--- /dev/null
+++ b/src/y2_tags.c
@@ -0,0 +1,326 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+
+/**
+ * @file   y2_tags.c
+ * @brief  Music object formats and tags from Reborn's library (read-only)
+ *
+ * libmtp track clients (Strawberry, mtp-tracks) skip Undefined objects and
+ * take the title from the Name property, so audio files are reported with
+ * their format and the tags Reborn already read. The library is written
+ * concurrently by Reborn: it is opened read-only, statements never stay
+ * open between lookups, and a missing, busy or broken library falls back to
+ * the file name silently.
+ */
+
+#include "buildconf.h"
+
+#include <inttypes.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <time.h>
+#include <sys/stat.h>
+#include <sqlite3.h>
+
+#include "mtp_constant.h"
+#include "y2_tags.h"
+#include "logs_out.h"
+
+#define Y2_TAGS_CACHE_MS 2000
+
+static const struct
+{
+	const char * extension;
+	uint16_t format;
+} audio_formats[] =
+{
+	{ "mp3",  MTP_FORMAT_MP3 },
+	{ "wav",  MTP_FORMAT_WAV },
+	{ "wma",  MTP_FORMAT_WMA },
+	{ "ogg",  MTP_FORMAT_OGG },
+	{ "oga",  MTP_FORMAT_OGG },
+	{ "opus", MTP_FORMAT_OGG },
+	{ "aac",  MTP_FORMAT_AAC },
+	{ "m4a",  MTP_FORMAT_M4A },
+	{ "flac", MTP_FORMAT_FLAC },
+};
+
+static const char select_tags[] =
+	"SELECT title,artist,album,album_artist,track,disc,duration_ms,sample_rate,channels,bitrate,genre FROM tracks "
+	"WHERE source_id IN (SELECT id FROM sources WHERE online=1) AND path=?1 AND deleted=0 LIMIT 1";
+
+// Libraries from before Reborn stored the genre.
+static const char select_tags_no_genre[] =
+	"SELECT title,artist,album,album_artist,track,disc,duration_ms,sample_rate,channels,bitrate FROM tracks "
+	"WHERE source_id IN (SELECT id FROM sources WHERE online=1) AND path=?1 AND deleted=0 LIMIT 1";
+
+static pthread_mutex_t tags_mutex = PTHREAD_MUTEX_INITIALIZER;
+static char database_path[512] = Y2_LIBRARY_DB;
+static sqlite3 * database;
+static sqlite3_stmt * statement;
+static dev_t database_dev;
+static ino_t database_ino;
+
+static char * cached_path;
+static int cached_found;
+static uint64_t cached_at;
+static y2_tags cached_tags;
+
+uint16_t y2_object_format(const char * name, int is_dir)
+{
+	const char * dot;
+	unsigned int i;
+
+	if( is_dir )
+		return MTP_FORMAT_ASSOCIATION;
+
+	// Hidden files are no music: a Mac leaves a 4 KiB "._" AppleDouble file
+	// next to every song it copies, which track clients listed as songs.
+	if( !name || name[0] == '.' )
+		return MTP_FORMAT_UNDEFINED;
+
+	dot = strrchr(name, '.');
+	if( !dot )
+		return MTP_FORMAT_UNDEFINED;
+
+	for( i = 0; i < sizeof(audio_formats) / sizeof(audio_formats[0]); i++ )
+	{
+		if( !strcasecmp(dot + 1, audio_formats[i].extension) )
+			return audio_formats[i].format;
+	}
+
+	return MTP_FORMAT_UNDEFINED;
+}
+
+int y2_format_is_audio(uint32_t format)
+{
+	unsigned int i;
+
+	for( i = 0; i < sizeof(audio_formats) / sizeof(audio_formats[0]); i++ )
+	{
+		if( format == audio_formats[i].format )
+			return 1;
+	}
+
+	return 0;
+}
+
+static uint64_t now_ms(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+// Copy a UTF-8 string, cut on a character boundary.
+static void copy_text(char * dst, const unsigned char * src)
+{
+	size_t len;
+
+	dst[0] = 0;
+	if( !src )
+		return;
+
+	len = strlen((const char *)src);
+	if( len >= Y2_TAG_SIZE )
+	{
+		len = Y2_TAG_SIZE - 1;
+		while( len && (src[len] & 0xC0) == 0x80 )
+			len--;
+	}
+
+	memcpy(dst, src, len);
+	dst[len] = 0;
+}
+
+static uint32_t column_u32(sqlite3_stmt * stmt, int col, uint32_t max)
+{
+	sqlite3_int64 v;
+
+	v = sqlite3_column_int64(stmt, col);
+	if( v < 0 )
+		return 0;
+	if( (uint64_t)v > max )
+		return max;
+	return (uint32_t)v;
+}
+
+static void close_database(void)
+{
+	if( statement )
+		sqlite3_finalize(statement);
+	statement = NULL;
+
+	if( database )
+		sqlite3_close(database);
+	database = NULL;
+}
+
+static int open_database(void)
+{
+	struct stat st;
+	char uri[sizeof(database_path) * 3 + 16];
+	const char * c;
+	int ofs;
+
+	if( stat(database_path, &st) )
+	{
+		close_database();
+		return -1;
+	}
+
+	// Reborn replaced the library (rebuild): read the new file.
+	if( database && ( st.st_dev != database_dev || st.st_ino != database_ino ) )
+		close_database();
+
+	if( database )
+		return 0;
+
+	ofs = snprintf(uri, sizeof(uri), "file:");
+	for( c = database_path; *c && ofs < (int)sizeof(uri) - 12; c++ )
+	{
+		if( *c == '%' || *c == '?' || *c == '#' )
+			ofs += snprintf(uri + ofs, sizeof(uri) - ofs, "%%%.2X", (unsigned char)*c);
+		else
+			uri[ofs++] = *c;
+	}
+	snprintf(uri + ofs, sizeof(uri) - ofs, "?mode=ro");
+
+	if( sqlite3_open_v2(uri, &database, SQLITE_OPEN_READONLY | SQLITE_OPEN_URI | SQLITE_OPEN_NOMUTEX, NULL) != SQLITE_OK )
+	{
+		PRINT_DEBUG("y2_tags : can't open %s : %s", database_path, database ? sqlite3_errmsg(database) : "no memory");
+		close_database();
+		return -1;
+	}
+
+	sqlite3_busy_timeout(database, 100);
+
+	if( sqlite3_prepare_v2(database, select_tags, -1, &statement, NULL) != SQLITE_OK &&
+	    sqlite3_prepare_v2(database, select_tags_no_genre, -1, &statement, NULL) != SQLITE_OK )
+	{
+		PRINT_DEBUG("y2_tags : can't query %s : %s", database_path, sqlite3_errmsg(database));
+		close_database();
+		return -1;
+	}
+
+	database_dev = st.st_dev;
+	database_ino = st.st_ino;
+
+	return 0;
+}
+
+static int lookup(const char * path, y2_tags * tags)
+{
+	int ret, found;
+
+	if( open_database() )
+		return 0;
+
+	found = 0;
+
+	if( sqlite3_bind_text(statement, 1, path, -1, SQLITE_STATIC) == SQLITE_OK )
+	{
+		ret = sqlite3_step(statement);
+		if( ret == SQLITE_ROW )
+		{
+			copy_text(tags->title, sqlite3_column_text(statement, 0));
+			copy_text(tags->artist, sqlite3_column_text(statement, 1));
+			copy_text(tags->album, sqlite3_column_text(statement, 2));
+			copy_text(tags->album_artist, sqlite3_column_text(statement, 3));
+			tags->track = column_u32(statement, 4, 0xFFFF);
+			tags->duration_ms = column_u32(statement, 6, 0xFFFFFFFF);
+			tags->sample_rate = column_u32(statement, 7, 0xFFFFFFFF);
+			tags->channels = column_u32(statement, 8, 0xFFFF);
+			tags->bitrate = column_u32(statement, 9, 0xFFFFFFFF);
+			if( sqlite3_column_count(statement) > 10 )
+				copy_text(tags->genre, sqlite3_column_text(statement, 10));
+			found = 1;
+		}
+		else if( ret != SQLITE_DONE )
+		{
+			PRINT_DEBUG("y2_tags : lookup failed (%d) : %s", ret, sqlite3_errmsg(database));
+		}
+	}
+
+	// Never keep a read snapshot open: Reborn checkpoints the WAL.
+	ret = sqlite3_reset(statement);
+	sqlite3_clear_bindings(statement);
+
+	if( ret != SQLITE_OK && ret != SQLITE_BUSY && ret != SQLITE_LOCKED )
+		close_database();
+
+	return found;
+}
+
+static void name_title(const char * name, char * title)
+{
+	const char * dot;
+	size_t len;
+
+	title[0] = 0;
+	if( !name )
+		return;
+
+	len = strlen(name);
+	dot = strrchr(name, '.');
+	if( dot && dot != name )
+		len = dot - name;
+
+	if( len >= Y2_TAG_SIZE )
+		len = Y2_TAG_SIZE - 1;
+
+	memcpy(title, name, len);
+	title[len] = 0;
+}
+
+int y2_tags_get(const char * path, const char * name, y2_tags * tags)
+{
+	int found;
+	uint64_t now;
+
+	memset(tags, 0, sizeof(y2_tags));
+
+	found = 0;
+
+	if( path && !pthread_mutex_lock(&tags_mutex) )
+	{
+		now = now_ms();
+		if( cached_path && !strcmp(cached_path, path) && now - cached_at < Y2_TAGS_CACHE_MS )
+		{
+			memcpy(tags, &cached_tags, sizeof(y2_tags));
+			found = cached_found;
+		}
+		else
+		{
+			found = lookup(path, tags);
+
+			free(cached_path);
+			cached_path = strdup(path);
+			cached_found = found;
+			cached_at = now;
+			memcpy(&cached_tags, tags, sizeof(y2_tags));
+		}
+		pthread_mutex_unlock(&tags_mutex);
+	}
+
+	if( !tags->title[0] )
+		name_title(name, tags->title);
+
+	return found;
+}
+
+void y2_tags_set_database(const char * path)
+{
+	pthread_mutex_lock(&tags_mutex);
+
+	close_database();
+	snprintf(database_path, sizeof(database_path), "%s", path ? path : Y2_LIBRARY_DB);
+
+	free(cached_path);
+	cached_path = NULL;
+
+	pthread_mutex_unlock(&tags_mutex);
+}
