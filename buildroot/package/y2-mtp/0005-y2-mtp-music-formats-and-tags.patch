@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef Y2_TAGS_H
+#define Y2_TAGS_H
+
+#include <stdint.h>
+
+/* Reborn's music library. Read-only: never created, written or migrated here. */
+#define Y2_LIBRARY_DB "/data/reborn/library.db"
+
+#define Y2_TAG_SIZE 768             // MTP strings hold 255 UTF-16 units
+
+typedef struct y2_tags_
+{
+	char title[Y2_TAG_SIZE];         // Tag title, else the file name without extension
+	char artist[Y2_TAG_SIZE];
+	char album[Y2_TAG_SIZE];
+	char album_artist[Y2_TAG_SIZE];
+	char genre[Y2_TAG_SIZE];
+	uint16_t track;
+	uint16_t channels;
+	uint32_t duration_ms;
+	uint32_t sample_rate;
+	uint32_t bitrate;                // Bits per second
+} y2_tags;
+
+/* MTP ObjectFormat of a file by its extension (case-insensitive): a known audio
+ * format, MTP_FORMAT_ASSOCIATION for a folder, else MTP_FORMAT_UNDEFINED. */
+uint16_t y2_object_format(const char * name, int is_dir);
+int y2_format_is_audio(uint32_t format);
+
+/* Tags of the audio file at path (absolute, as Reborn stores it) from the online
+ * sources of the library. Always fills tags; returns 1 when the library had the
+ * track, 0 when it fell back to the file name (missing, busy or unknown). */
+int y2_tags_get(const char * path, const char * name, y2_tags * tags);
+
+/* Library location (NULL: Y2_LIBRARY_DB). Closes the open connection. */
+void y2_tags_set_database(const char * path);
+
+#endif
