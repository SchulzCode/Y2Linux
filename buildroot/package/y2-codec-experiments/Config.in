config BR2_PACKAGE_Y2_CODEC_EXPERIMENTS
	bool "Y2 owner-private Bluetooth encoder qualification"
	depends on BR2_PACKAGE_BLUEZ_ALSA
	depends on BR2_PACKAGE_FDK_AAC_ARCH_SUPPORTS
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_FDK_AAC
	select BR2_PACKAGE_LIBFREEAPTX
	select BR2_PACKAGE_LIBLDAC
	help
	  Build AAC, aptX, aptX HD and LDAC for owner-private experiments.
	  Private integration images enable these endpoints experimentally.
	  SBC remains the bounded fallback. No public distribution approval
	  or physical qualification is implied; public packaging rejects this profile.
