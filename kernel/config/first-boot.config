CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_AEABI=y
# PID1 uses ARM EABI syscall 162 (nanosleep_time32).
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_MMU=y
CONFIG_SMP=y
CONFIG_HIGHMEM=y
CONFIG_ARM_LPAE=n
CONFIG_CPU_BIG_ENDIAN=n
CONFIG_THUMB2_KERNEL=n
CONFIG_ARM_VIRT_EXT=n
CONFIG_EFI=n
CONFIG_EFI_STUB=n
CONFIG_XIP_KERNEL=n
CONFIG_ZBOOT_ROM=n
CONFIG_AUTO_ZRELADDR=y
CONFIG_ARM_APPENDED_DTB=y
CONFIG_ARM_ATAG_DTB_COMPAT=n
CONFIG_KERNEL_GZIP=y
CONFIG_CMDLINE="rdinit=/init"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE_EXTEND=n
CONFIG_CMDLINE_FORCE=n
CONFIG_LOCALVERSION="-y2linux-dev01"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_EXPERT=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=20
CONFIG_BUG=y
CONFIG_KALLSYMS=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_SERIAL_8250_DMA=n
CONFIG_SERIAL_EARLYCON=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLOCK=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=n
CONFIG_MODULE_FORCE_LOAD=n
CONFIG_MODVERSIONS=n
CONFIG_SWAP=n
CONFIG_CMA=n
CONFIG_DMA_CMA=n
CONFIG_DMADEVICES=n
CONFIG_KEXEC=n
CONFIG_KEXEC_FILE=n
CONFIG_CRASH_DUMP=n
CONFIG_DRM=y
CONFIG_SOUND=n
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO_POLLED=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_CDEV=n
CONFIG_GPIO_SYSFS=n
CONFIG_PINCTRL=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=n
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_GADGET=y
CONFIG_USB_MUSB_HOST=n
CONFIG_USB_MUSB_DUAL_ROLE=n
CONFIG_USB_MUSB_MEDIATEK=n
CONFIG_MUSB_PIO_ONLY=y
CONFIG_USB_INVENTRA_DMA=n
CONFIG_USB_PHY=n
CONFIG_USB_G_SERIAL=n
CONFIG_USB_CDC_COMPOSITE=y
CONFIG_U_SERIAL_CONSOLE=n
CONFIG_MTD=n
CONFIG_I2C=y
CONFIG_SPI=n
CONFIG_WATCHDOG=n
CONFIG_PM=y
CONFIG_CPU_IDLE=n
CONFIG_CPU_FREQ=n
CONFIG_ARM_ARCH_TIMER=n
CONFIG_HZ_100=y
CONFIG_DEBUG_INFO_NONE=y
CONFIG_SECURITY=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_ARM_PATCH_PHYS_VIRT=n
CONFIG_PHYS_OFFSET=0x80000000
CONFIG_VMSPLIT_3G=y
CONFIG_PAGE_OFFSET=0xC0000000
CONFIG_ATAGS=n
CONFIG_DEBUG_LL=n
CONFIG_MEMORY_HOTPLUG=n
CONFIG_KVM=n

# Y2 bounded baseline and proven early watchdog stop.
CONFIG_Y2_BOOT_DIAGNOSTIC=y

# One M2 development baseline; no block device driver or disk filesystems.
CONFIG_NR_CPUS=4
CONFIG_HOTPLUG_CPU=n
CONFIG_I2C_MT65XX=y
CONFIG_I2C_CHARDEV=y
CONFIG_INPUT_MISC=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6323=y
CONFIG_POWER_SUPPLY=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_COMMON_CLK_MEDIATEK=y
CONFIG_MTK_MMSYS=y
CONFIG_MTK_CMDQ=n
CONFIG_DRM_MEDIATEK=m
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_BRIDGE_CONNECTOR=y
CONFIG_DRM_GEM_DMA_HELPER=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM_LIMA=n
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_HSQ=y
CONFIG_DEBUG_FS=y
CONFIG_DEVMEM=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_PM_DEBUG=n

# Development glibc/rootfs and userspace diagnostics.
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
CONFIG_UNIX98_PTYS=y
CONFIG_EXT4_FS=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_UNIX_DIAG=y
CONFIG_CRYPTO_USER_API_RNG=n
