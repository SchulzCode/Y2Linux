CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=n
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_MT6323=y

# Production platform, internal MMC and removable media.
CONFIG_NR_CPUS=4
# Production Y2 CPU1-3 hotplug uses verified WFI then SPM MTCMOS removal.
CONFIG_HOTPLUG_CPU=y
CONFIG_I2C_MT65XX=y
CONFIG_I2C_CHARDEV=y
CONFIG_INPUT_MISC=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_MFD_MT6397=y
