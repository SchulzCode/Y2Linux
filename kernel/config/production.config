CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_UNIX_DIAG=y
CONFIG_CRYPTO_USER_API_RNG=n

# Standard boot/session identity and production sysctl interface.
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y

# M5 production shared CONSYS, native networking and standard HCI.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=y
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
