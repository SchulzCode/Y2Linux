CONFIG_BT_HIDP=n
CONFIG_BT_BNEP=n
CONFIG_UHID=y
CONFIG_Y2_CONNECTIVITY=y
CONFIG_RESET_CONTROLLER=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
