CONFIG_SUSPEND=y
CONFIG_HIBERNATION=n
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_PM_TEST_SUSPEND=n

# Production glibc/rootfs and optional userspace diagnostics.
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
