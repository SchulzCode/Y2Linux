# Shared Y2 production platform and proven early watchdog stop.
CONFIG_Y2_PLATFORM=y
CONFIG_Y2_POWER=y
CONFIG_IIO=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
