/* One canonical hardware description; production candidate scope below. */
#include "innioasis-y2.dts"

/* Physical 01 verified 8/4 pins. Exact stock LK/MSDC data supports SDR HS
 * from the inherited 200 MHz source. Start qualification at 25 MHz; the
 * host's bounded y2_clock_limit_hz control permits later 50 MHz testing.
 * Keep 3.3 V, no DDR/UHS/HS200, and normal card-capability fallback. */
&mmc0 { bus-width = <8>; max-frequency = <50000000>; cap-mmc-highspeed; };
&mmc1 { bus-width = <4>; max-frequency = <50000000>; cap-sd-highspeed; };

/ {
    /* Stock and Physical 01 diagnostic: secure physical timer is PPI29;
     * GPT6 supplies 13 MHz. LK leaves CNTFRQ=0, hence explicit frequency.
     * No always-on claim across CPU/cluster power-down or system suspend. */
    local-timer {
        compatible = "arm,armv7-timer";
        interrupt-parent = <&gic>;
        interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(4) | IRQ_TYPE_LEVEL_HIGH)>;
        clock-frequency = <13000000>;
        arm,cpu-registers-not-fw-configured;
        arm,no-tick-in-suspend;
    };
};
