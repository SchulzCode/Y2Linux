 /* ------------------------------------------------------------ */
 
+#if IS_ENABLED(CONFIG_Y2_PLATFORM)
+/* Y2 multi-packet (mode 1) receive for requests that end on a short or
+ * zero-length packet (MTP, ECM), switched on at run time (sysfs rx_dma=2).
+ * The engine moves every full packet of the request with no CPU work; with
+ * DMA request mode 1 the controller raises no DMA request for a short packet
+ * and interrupts the CPU instead. y2_rx_mode1_end() then stops the channel
+ * after the last whole packet and reads the short packet itself. Upstream
+ * uses mode 1 only for short_not_ok (mass storage), so does the stock
+ * MediaTek kernel; everything else there costs interrupts per packet.
+ *
+ * Context: controller locked, IRQs blocked, endpoint selected, request
+ * mapped, RXPKTRDY set with fifo_count bytes waiting.
+ *
+ * Returns Y2_M1_STARTED, Y2_M1_PIO (nothing moved: the CPU takes the packet),
+ * Y2_M1_AGAIN (the engine started after all, whole packets are in memory and
+ * the buffer is unmapped: analyse the FIFO again) or Y2_M1_FAILED (part of a
+ * packet moved: the rest was flushed and the request given back with -EIO,
+ * the host repeats the transfer).
+ */
+enum { Y2_M1_PIO, Y2_M1_STARTED, Y2_M1_AGAIN, Y2_M1_FAILED };
+static int y2_rx_mode1_start(struct musb *musb, struct musb_ep *musb_ep,
+			     struct musb_request *req, u16 csr, u16 fifo_count)
+{
+	struct usb_request *request = &req->request;
+	struct dma_controller *c = musb->dma_controller;
+	struct dma_channel *channel = musb_ep->dma;
+	void __iomem *epio = musb_ep->hw_ep->regs;
+	u16 packet = musb_ep->packet_sz;
+	u32 length = request->length - request->actual, moved, programmed, left;
+	int kick, i;
+
+	if (!channel || fifo_count != packet || length < packet)
+		return Y2_M1_PIO;
+	length = min_t(u32, length - length % packet, channel->max_len);
+
+	/* The upstream mass-storage sequence (AUTOCLEAR, DMAENAB, then a
+	 * DMAMODE pulse to make the controller raise DMAReq for the packet
+	 * that is already waiting), left in request mode 1. */
+	csr &= ~MUSB_RXCSR_DMAMODE;
+	csr |= MUSB_RXCSR_AUTOCLEAR;
+	musb_writew(epio, MUSB_RXCSR, csr);
+	csr |= MUSB_RXCSR_DMAENAB;
+	musb_writew(epio, MUSB_RXCSR, csr);
+	musb_writew(epio, MUSB_RXCSR, csr | MUSB_RXCSR_DMAMODE);
+	musb_writew(epio, MUSB_RXCSR, csr);
+	musb_writew(epio, MUSB_RXCSR, csr | MUSB_RXCSR_DMAMODE);
+
+	channel->desired_mode = 1;
+	if (!c->channel_program(channel, packet, 1,
+				request->dma + request->actual, length)) {
+		csr &= ~(MUSB_RXCSR_AUTOCLEAR | MUSB_RXCSR_DMAENAB);
+		musb_writew(epio, MUSB_RXCSR, csr);
+		return Y2_M1_PIO;
+	}
+
+	/* The waiting packet must start moving at once. If the engine never
+	 * saw the request, pulse DMAMODE again, then give up and let the CPU
+	 * take the packet, but only once the stopped engine shows that nothing
+	 * reached memory: it may start after the last sample. */
+	for (kick = 0; kick < 3; kick++) {
+		for (i = 0; i < 20; i++) {
+			moved = y2_hsdma_moved(channel, &programmed, &left);
+			if (moved || left != programmed ||
+			    !(musb_readw(epio, MUSB_RXCSR) & MUSB_RXCSR_RXPKTRDY))
+				goto started;
+			udelay(1);
+		}
+		if (kick == 2)
+			break;
+		Y2_RXEV(Y2_RX_M1_KICK, req->epnum, musb_readw(epio, MUSB_RXCSR), kick);
+		musb_writew(epio, MUSB_RXCSR, csr);
+		musb_writew(epio, MUSB_RXCSR, csr | MUSB_RXCSR_DMAMODE);
+	}
+	moved = y2_hsdma_stop(channel);
+	c->channel_abort(channel);
+	Y2_RXEV(Y2_RX_M1_FALLBACK, req->epnum, musb_readw(epio, MUSB_RXCSR),
+		moved ? moved | 0x20000000 : left);
+	if (!moved)
+		return Y2_M1_PIO;
+	request->actual += moved - moved % packet;
+	unmap_dma_buffer(req, musb);
+	if (!(moved % packet))
+		return Y2_M1_AGAIN;
+	/* The rest of that packet is still at the FIFO head. */
+	csr = musb_readw(epio, MUSB_RXCSR);
+	if (csr & MUSB_RXCSR_RXPKTRDY)
+		musb_writew(epio, MUSB_RXCSR, (csr | MUSB_RXCSR_FLUSHFIFO |
+			    MUSB_RXCSR_P_WZC_BITS) & ~MUSB_RXCSR_RXPKTRDY);
+	musb_g_giveback(musb_ep, request, -EIO);
+	return Y2_M1_FAILED;
+started:
+	Y2_RXEV(Y2_RX_M1_PROG, req->epnum, csr, length);
+	return Y2_M1_STARTED;
+}
+
+/* Endpoint interrupt while a mode-1 transfer is busy. Returns true when the
+ * request was given back. Context as for musb_g_rx().
+ *
+ * RXCOUNT falls while the engine unloads a full packet (seen on the Y2: a
+ * single sample mid-unload looked like a short packet and cut a file in
+ * two), so a short or zero-length packet is only believed when two samples
+ * a few microseconds apart agree and the engine has stopped on a whole
+ * packet. */
+static bool y2_rx_mode1_end(struct musb *musb, struct musb_ep *musb_ep,
+			    struct musb_request *req)
+{
+	struct usb_request *request = &req->request;
+	struct dma_channel *channel = musb_ep->dma;
+	void __iomem *epio = musb_ep->hw_ep->regs;
+	u16 packet = musb_ep->packet_sz, csr = 0, count = 0, count2;
+	u32 moved = 0, moved2, programmed = 0, left = 0;
+	int i, status = 0;
+
+	for (i = 0; i < 50; i++) {
+		csr = musb_readw(epio, MUSB_RXCSR);
+		count = musb_readw(epio, MUSB_RXCOUNT);
+		moved = y2_hsdma_moved(channel, &programmed, &left);
+		udelay(2);
+		/* Nothing for the CPU, or the channel finished: its pending
+		 * completion gives the request back and rxstate() goes on. */
+		if (!(musb_readw(epio, MUSB_RXCSR) & MUSB_RXCSR_RXPKTRDY) ||
+		    !(csr & MUSB_RXCSR_RXPKTRDY))
+			goto busy;
+		moved2 = y2_hsdma_moved(channel, &programmed, &left);
+		if (moved2 >= programmed)
+			goto busy;
+		count2 = musb_readw(epio, MUSB_RXCOUNT);
+		/* A full packet is the engine's to take. */
+		if (count >= packet && count2 >= packet)
+			goto busy;
+		if (count2 == count && moved2 == moved && count < packet &&
+		    !(moved % packet))
+			goto short_packet;
+		if (count2 != count || moved2 != moved)
+			Y2_RXEV(Y2_RX_BUSY, req->epnum, csr, count | 0x40000000);
+	}
+busy:
+	Y2_RXEV(Y2_RX_BUSY, req->epnum, csr, count | i << 16);
+	return false;
+
+short_packet:
+	if (moved + left != programmed)
+		/* Address and count registers disagree: recorded for the
+		 * device tests, the address is what upstream trusts. */
+		Y2_RXEV(Y2_RX_M1_FALLBACK, req->epnum, csr, left | 0x40000000);
+
+	/* No completion is pending: the channel stopped short of its length. */
+	musb->dma_controller->channel_abort(channel);
+	request->actual += moved;
+	/* The CPU owns the buffer before it writes the short packet. */
+	unmap_dma_buffer(req, musb);
+
+	csr = musb_readw(epio, MUSB_RXCSR);
+	count2 = musb_readw(epio, MUSB_RXCOUNT);
+	if (!(csr & MUSB_RXCSR_RXPKTRDY) || count2 != count) {
+		/* Never expected once both samples agreed: fail the request
+		 * rather than hand back data whose end is unknown. */
+		Y2_RXEV(Y2_RX_M1_FALLBACK, req->epnum, csr, count2 | 0x80000000);
+		status = -EIO;
+	}
+	count = min_t(u32, count, request->length - request->actual);
+	if (count && !status) {
+		musb_read_fifo(musb_ep->hw_ep, count,
+			       (u8 *)(request->buf + request->actual));
+		request->actual += count;
+		y2_musb_pio_progress(musb, count, false);
+	}
+	csr |= MUSB_RXCSR_P_WZC_BITS;
+	csr &= ~MUSB_RXCSR_RXPKTRDY;
+	musb_writew(epio, MUSB_RXCSR, csr);
+	Y2_RXEV(Y2_RX_M1_END, req->epnum, csr, moved | (u32)count << 20);
+	musb_g_giveback(musb_ep, request, status);
+	return true;
+}
+#endif
