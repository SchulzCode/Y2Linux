+static int mt6323_write_masks(struct mt6397_chip *chip, const u16 *masks)
+{
+	int i, ret, first = 0;
+	for (i = 0; i < 3 && chip->int_con[i]; i++) {
+		ret = regmap_write(chip->regmap, chip->int_con[i], masks[i]);
+		if (ret && !first) first = ret;
+	}
+	return first;
+}
+int mt6323_irq_suspend(struct device *dev)
+{
+	struct mt6397_chip *chip = dev_get_drvdata(dev);
+	int ret, restore;
+	if (chip->chip_id != MT6323_CHIP_ID) return 0;
+	mutex_lock(&chip->irqlock);
+	ret = mt6323_write_masks(chip, chip->wake_mask);
+	if (!ret && (chip->wake_mask[0] || chip->wake_mask[1])) {
+		ret = enable_irq_wake(chip->irq);
+		chip->irq_wake_enabled = !ret;
+	}
+	if (ret) {
+		restore = mt6323_write_masks(chip, chip->irq_masks_cur);
+		if (restore) dev_err(dev, "failed to restore PMIC IRQ masks: %d\n", restore);
+	} else chip->irq_suspended = true;
+	mutex_unlock(&chip->irqlock);
+	return ret;
+}
+int mt6323_irq_resume(struct device *dev)
+{
+	struct mt6397_chip *chip = dev_get_drvdata(dev);
+	int ret, wake_ret = 0;
+	if (chip->chip_id != MT6323_CHIP_ID) return 0;
+	mutex_lock(&chip->irqlock);
+	chip->irq_suspended = false;
+	ret = mt6323_write_masks(chip, chip->irq_masks_cur);
+	if (chip->irq_wake_enabled) {
+		wake_ret = disable_irq_wake(chip->irq);
+		if (!wake_ret) chip->irq_wake_enabled = false;
+	}
+	mutex_unlock(&chip->irqlock);
+	return ret ? ret : wake_ret;
 }
 
