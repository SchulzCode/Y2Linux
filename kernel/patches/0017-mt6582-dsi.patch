+/* POWER-FINAL-22: parking LK's video stream leaves the lit panel without a
+ * picture until Linux's first modeset streams (≈40 ms at boot): the owner saw
+ * a colour flash. Darken the panel's backlight for the hand-over and relight it
+ * 50 ms after the first Linux enable, or after 3 s if no enable ever comes. */
+static void y2_backlight_set(struct backlight_device *bd, int power)
+{
+ mutex_lock(&bd->ops_lock);
+ bd->props.power = power;
+ mutex_unlock(&bd->ops_lock);
+ backlight_update_status(bd);
+}
+static void y2_relight_work(struct work_struct *work)
+{
+ struct mtk_dsi *dsi = container_of(to_delayed_work(work), struct mtk_dsi, y2_relight);
+ if (!dsi->y2_dark) return;
+ dsi->y2_dark = false;
+ y2_backlight_set(dsi->y2_bl, BACKLIGHT_POWER_ON);
+ dev_info(dsi->dev, "handoff: backlight restored\n");
+}
+static void y2_relight_release(void *data)
+{
+ struct mtk_dsi *dsi = data;
+ cancel_delayed_work_sync(&dsi->y2_relight);
+ if (dsi->y2_dark) { dsi->y2_dark = false; y2_backlight_set(dsi->y2_bl, BACKLIGHT_POWER_ON); }
+ put_device(&dsi->y2_bl->dev);
+}
+static void y2_handoff_dark(struct mtk_dsi *dsi)
+{
+ struct device_node *panel = of_get_child_by_name(dsi->dev->of_node, "panel");
+ struct device_node *np = panel ? of_parse_phandle(panel, "backlight", 0) : NULL;
+ of_node_put(panel);
+ if (np) { dsi->y2_bl = of_find_backlight_by_node(np); of_node_put(np); }
+ if (!dsi->y2_bl) { dev_info(dsi->dev, "handoff: no backlight to darken\n"); return; }
+ INIT_DELAYED_WORK(&dsi->y2_relight, y2_relight_work);
+ if (devm_add_action_or_reset(dsi->dev, y2_relight_release, dsi)) { dsi->y2_bl = NULL; return; }
+ if (dsi->y2_bl->props.power != BACKLIGHT_POWER_ON) return; /* not lit: nothing to hide */
+ dsi->y2_dark = true;
+ y2_backlight_set(dsi->y2_bl, BACKLIGHT_POWER_OFF);
+ schedule_delayed_work(&dsi->y2_relight, msecs_to_jiffies(3000));
+ dev_info(dsi->dev, "handoff: backlight off until the first Linux frame\n");
+}
