+static int mt6582_dsi_park(struct mtk_dsi *dsi)
+{
+ u32 v; int ret;
+ /* The PHY adopts live LK power without retuning it. Its rate is unknown
+  * until the stream is parked and the normal modeset owns the PLL. */
+ ret = phy_power_on(dsi->phy);
+ if (ret) return ret;
+ ret = clk_prepare_enable(dsi->engine_clk);
+ if (ret) goto phy_off;
+ ret = clk_prepare_enable(dsi->digital_clk);
+ if (ret) goto engine_off;
+ writel(0, dsi->regs + DSI_INTEN);
+ v = readl(dsi->regs + DSI_MODE_CTRL);
+ if (v & MODE) {
+  writel(v & ~MODE, dsi->regs + DSI_MODE_CTRL);
+  ret = readl_poll_timeout(dsi->regs + DSI_INTSTA, v, !(v & DSI_BUSY), 1000, 100000);
+  if (ret) dev_err(dsi->dev, "inherited DSI failed to park; no OVL takeover\n");
+ }
+ if (!ret) {
+  writel(0, dsi->regs + DSI_START);
+  writel(0, dsi->regs + DSI_INTSTA);
+  dev_info(dsi->dev, "inherited DSI parked; releasing PHY before Linux modeset\n");
+ }
+ clk_disable_unprepare(dsi->digital_clk);
+engine_off:
+ clk_disable_unprepare(dsi->engine_clk);
+phy_off:
+ phy_power_off(dsi->phy);
+ return ret;
+}
