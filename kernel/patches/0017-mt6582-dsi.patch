+/* Read-only bounded post-modeset observation. Only scheduled with DSI powered;
+ * cancel synchronously before bridge disable so no unclocked access occurs.
+ * Component registers are the same retained MT6582 map used by their owners. */
+static void y2_scanout_sample(struct work_struct *work)
+{
+    struct mtk_dsi *dsi = container_of(to_delayed_work(work), struct mtk_dsi, y2_sample);
+    void __iomem *o=dsi->y2_ovl, *r=dsi->y2_rdma, *c=dsi->y2_color;
+    void __iomem *m=dsi->y2_mm, *u=dsi->y2_mutex, *g=dsi->y2_pins, *p=dsi->y2_phy;
+    if (!dsi->refcount) return;
+    dev_info(dsi->dev, "Y2SCAN sample=%u vblank=%llu DSI irq=%u mode=%08x start=%08x con=%08x inten=%08x status=%08x txrx=%08x ps=%08x vactive=%u lcc=%08x ld0=%08x\n",
+        dsi->y2_samples, (unsigned long long)(dsi->y2_vblank ? drm_crtc_vblank_count(dsi->y2_crtc) : 0), READ_ONCE(dsi->y2_irqs), readl(dsi->regs+0x14),
+        readl(dsi->regs), readl(dsi->regs+0x10), readl(dsi->regs+8),
+        readl(dsi->regs+0xc), readl(dsi->regs+0x18), readl(dsi->regs+0x1c),
+        readl(dsi->regs+0x2c), readl(dsi->regs+0x104), readl(dsi->regs+0x108));
+    dev_info(dsi->dev, "Y2SCAN OVL en=%08x irq=%08x src=%08x addr=%08x con=%08x pitch=%08x RDMA con=%08x irq=%08x size=%08x/%08x fifo=%08x COLOR cfg=%08x en=%08x size=%u/%u\n",
+        readl(o+0xc),readl(o+8),readl(o+0x2c),readl(o+0x40),readl(o+0x30),readl(o+0x44),
+        readl(r+0x10),readl(r+4),readl(r+0x14),readl(r+0x18),readl(r+0x40),
+        readl(c+0x400),readl(c+0xf00),readl(c+0xf50),readl(c+0xf54));
+    dev_info(dsi->dev, "Y2SCAN MMSYS mout30=%08x out4c=%08x dsi50=%08x reset=%08x CG=%08x/%08x MUTEX en=%08x get=%08x mod=%08x sof=%08x GPIO112 mux=%u dir=%u out=%u in=%u PHY con=%08x pll=%08x/%08x/%08x pwr=%08x\n",
+        readl(m+0x30),readl(m+0x4c),readl(m+0x50),readl(m+0x13c),readl(m+0x100),readl(m+0x110),
+        readl(u+0x20),readl(u+0x24),readl(u+0x2c),readl(u+0x30),
+        (readl(g+0x760)>>6)&7,readl(g+0x70)&1,readl(g+0x470)&1,readl(g+0x570)&1,
+        readl(p),readl(p+0x50),readl(p+0x54),readl(p+0x58),readl(p+0x68));
+    if (++dsi->y2_samples < 4) {
+        schedule_delayed_work(&dsi->y2_sample, msecs_to_jiffies(1000));
+    } else if (dsi->y2_vblank) {
+        drm_crtc_vblank_put(dsi->y2_crtc);
+        dsi->y2_vblank = false;
+    }
+}
