+/* POWER-FINAL-44: on some boots (archive 20261016/143, the restart-entered
+ * recovery after 43's install) the DSI register port answers every read with
+ * the data of the previous read: the whole register file reads shifted by one
+ * word. Every read-modify-write then stores a neighbour's value, DSI_EN never
+ * sticks and no frame starts. PSCTRL and VACT_NL hold known, different values
+ * after the timing setup; read them back to back. */
+static bool y2_dsi_reads_lag(struct mtk_dsi *dsi)
+{
+	u32 ps = readl(dsi->regs + DSI_PSCTRL);
+	u32 vact = readl(dsi->regs + DSI_VACT_NL);
+
+	if (vact == dsi->vm.vactive)
+		return false;
+	/* MMSYS DCM group 1 (DSI/DPI): 0xf = no DCM (POWER-FINAL-47). */
+	dev_warn(dsi->dev, "Y2SCAN DSI read-back ps=%08x vact=%08x expected vact=%08x dcm1=%08x\n",
+		 ps, vact, dsi->vm.vactive, dsi->y2_mm ? readl(dsi->y2_mm + 0x12c) : 0xdeadbeef);
+	return true;
+}
