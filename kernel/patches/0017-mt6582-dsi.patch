+/* F17 (report 51f3b06d): the read lag outlived three DSI power cycles and a
+ * DIS power-down (screen-off with dis_pdn, mutex back at reset values), so its
+ * cause sits outside the DSI block. What it does is known: every read answers
+ * with the data of the read before it (PSCTRL read 0, VACT_NL read PSCTRL),
+ * while writes land. Once the power cycles have failed, every DSI register is
+ * read twice, back to back under a lock, and the second answer is used: the
+ * read-modify-writes store the right values again and frames start. Reading
+ * twice is harmless when the port answers in time, so it stays on until the
+ * next boot. Other blocks are read once. */
+static void __iomem *y2_dsi_twice;
+static DEFINE_RAW_SPINLOCK(y2_dsi_read_lock);
+static u32 y2_dsi_readl(const volatile void __iomem *addr)
+{
+	void __iomem *base = READ_ONCE(y2_dsi_twice);
+	unsigned long flags;
+	u32 v;
+
+	if (likely(!base || addr < base || addr >= base + 0x1000))
+		return readl(addr);
+	raw_spin_lock_irqsave(&y2_dsi_read_lock, flags);
+	(void)readl(addr);
+	v = readl(addr);
+	raw_spin_unlock_irqrestore(&y2_dsi_read_lock, flags);
+	return v;
+}
+#undef readl
+#define readl(c) y2_dsi_readl(c)
+
+/* Read-only bounded post-modeset observation. Only scheduled with DSI powered;
+ * cancel synchronously before bridge disable so no unclocked access occurs.
+ * Component registers are the same retained MT6582 map used by their owners. */
+/* OTA-35 follow-up: a software restart leaves the pipeline without frames
+ * (OVL never completes, vblank stays 1) although the DSI registers equal a
+ * cold start. Keep two whole-block snapshots of the display path, taken by
+ * the sampler below while DSI is powered, for a cold/warm diff over debugfs.
+ * Read-only; M4U is not read (its INFRA clock is normally gated). */
+struct y2_block { const char *name; unsigned base, first, last; };
+static const struct y2_block y2_blocks[] = {
+    {"MMSYS", 0x14000000, 0x000, 0x1fc}, {"OVL", 0x14007000, 0x000, 0x2fc},
+    {"RDMA", 0x14008000, 0x000, 0x0fc}, {"MUTEX", 0x1400e000, 0x000, 0x0fc},
+    {"LARB0", 0x14010000, 0x000, 0x0fc}, {"LARB0", 0x14010000, 0x200, 0x2fc},
+    {"LARB0", 0x14010000, 0xf00, 0xf3c}, {"LARB0", 0x14010000, 0x400, 0x4fc},
+    {"SMI", 0x14011000, 0x000, 0x4fc},
+    {"INFRA", 0x10001000, 0x000, 0x0fc}, {"TOPCK", 0x10000000, 0x000, 0x0fc},
+    {"SPM", 0x10006000, 0x60c, 0x610}, {"DSI", 0x1400c000, 0x000, 0x1fc},
+    {"MIPITX", 0x10010000, 0x000, 0x0fc}, {"APMIXED", 0x10209000, 0x000, 0x2fc},
+};
+#define Y2_SNAP_WORDS 2048
+/* Slots 0/1: the sampler after Linux's modeset. Slot 2: probe, before Linux
+ * touches LK's live pipeline (LK's clocks are protected from the unused
+ * sweep). Slot 3: right after the inherited DSI is parked (POWER-FINAL-40:
+ * is SMI larb0 already busy when Linux takes over after a restart?). */
+#define Y2_SNAP_SLOTS 4
+static u32 y2_snap[Y2_SNAP_SLOTS][Y2_SNAP_WORDS];
+static unsigned y2_snap_taken;
+static u64 y2_snap_vblank[Y2_SNAP_SLOTS];
+static const char *const y2_snap_names[Y2_SNAP_SLOTS] = {"after-modeset-0", "after-modeset-1", "handover", "parked"};
+static void __iomem *y2_block_base(struct mtk_dsi *dsi, unsigned base)
+{
+    switch (base) {
+    case 0x14000000: return dsi->y2_mm;
+    case 0x14007000: return dsi->y2_ovl;
+    case 0x14008000: return dsi->y2_rdma;
+    case 0x1400e000: return dsi->y2_mutex;
+    case 0x14010000: return dsi->y2_larb;
+    case 0x14011000: return dsi->y2_smi;
+    case 0x10001000: return dsi->y2_infra;
+    case 0x10000000: return dsi->y2_top;
+    case 0x10006000: return dsi->y2_spm;
+    case 0x1400c000: return dsi->regs;
+    case 0x10010000: return dsi->y2_phy;
+    case 0x10209000: return dsi->y2_apmixed;
+    }
+    return NULL;
+}
+static void y2_snapshot(struct mtk_dsi *dsi, unsigned slot, u64 vblank)
+{
+    unsigned i, n = 0, off;
+    if (slot >= 2 && (y2_snap_taken & (1U << slot)))
+        return; /* keep the first handover of this boot (probe may repeat) */
+    for (i = 0; i < ARRAY_SIZE(y2_blocks); i++) {
+        void __iomem *b = y2_block_base(dsi, y2_blocks[i].base);
+        for (off = y2_blocks[i].first; off <= y2_blocks[i].last && n < Y2_SNAP_WORDS; off += 4)
+            y2_snap[slot][n++] = b ? readl(b + off) : 0xdeadbeef;
+    }
+    y2_snap_vblank[slot] = vblank;
+    y2_snap_taken |= 1U << slot;
+}
+static int y2_snapshot_show(struct seq_file *f, void *unused)
+{
+    unsigned slot, i, n, off;
+    for (slot = 0; slot < Y2_SNAP_SLOTS; slot++) {
+        if (!(y2_snap_taken & (1U << slot))) continue;
+        seq_printf(f, "sample %u %s vblank %llu\n", slot, y2_snap_names[slot],
+                   (unsigned long long)y2_snap_vblank[slot]);
+        for (i = 0, n = 0; i < ARRAY_SIZE(y2_blocks); i++)
+            for (off = y2_blocks[i].first; off <= y2_blocks[i].last && n < Y2_SNAP_WORDS; off += 4)
+                seq_printf(f, "%u %s %08x %08x\n", slot, y2_blocks[i].name, y2_blocks[i].base + off, y2_snap[slot][n++]);
+    }
+    return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(y2_snapshot);
