+/* A pending request, DMA, controller/FIFO activity or unserviced interrupt
+ * refuses the gate; the runtime core retries at the next autosuspend expiry. */
+static int y2_msdc_runtime_suspend(struct device *dev, struct mmc_host *mmc,
+				   struct msdc_host *host)
+{
+	enum y2_msdc_rpm_busy busy;
+	unsigned int i;
+
+	busy = y2_msdc_rpm_busy(!!READ_ONCE(host->mrq),
+		readl(host->base + Y2_MSDC_DMA_CFG), readl(host->base + Y2_SDC_STS),
+		readl(host->base + Y2_MSDC_FIFOCS), readl(host->base + Y2_MSDC_INT),
+		readl(host->base + Y2_MSDC_INTEN));
+	if (busy != Y2_MSDC_IDLE) {
+		host->y2_rpm_refused[busy]++;
+		if (host->hsq_en && mmc_hsq_resume(mmc))
+			dev_err(dev, "HSQ rollback failed\n");
+		return -EBUSY;
+	}
+	for (i = 0; i < Y2_MSDC_RETAINED; i++)
+		host->y2_rpm_saved[i] = readl(host->base + y2_msdc_retained[i]);
+	/* Exact stock order: MS mode, then PERI MSDC CG. */
+	writel(host->y2_rpm_saved[0] & ~(Y2_MSDC_CFG_MODE | Y2_MSDC_CFG_VOLATILE),
+	       host->base + Y2_MSDC_CFG);
+	msdc_gate_clock(host);
+	host->y2_rpm_gated = true;
+	host->y2_rpm_suspends++;
+	return 0;
+}
