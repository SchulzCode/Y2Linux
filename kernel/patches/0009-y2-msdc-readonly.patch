+		if (level_caps & Y2_CAP_DDR)
+			*caps |= MMC_CAP_UHS_DDR50;
+		if (level_caps & Y2_CAP_TOP)
+			*caps |= MMC_CAP_UHS_SDR104;
+	} else {
+		if (level_caps & Y2_CAP_HS)
+			*caps |= MMC_CAP_MMC_HIGHSPEED;
+		if (level_caps & Y2_CAP_DDR)
+			*caps |= MMC_CAP_1_8V_DDR;
+		if (level_caps & Y2_CAP_TOP)
+			*caps2 |= MMC_CAP2_HS200_1_8V_SDR;
+	}
