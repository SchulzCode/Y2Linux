+static ssize_t y2_clock_limit_hz_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct mmc_host *mmc = dev_get_drvdata(dev);
+	struct msdc_host *host = mmc_priv(mmc);
+	unsigned int limit, previous;
+	int ret = kstrtouint(buf, 0, &limit);
+	if (ret) return ret;
+	if (limit != 13000000 && limit != 25000000 && limit != 50000000 &&
+	    limit != 100000000 && limit != 200000000)
+		return -EINVAL;
+	if (limit > mmc->f_max) return -ERANGE;
+	mmc_claim_host(mmc);
+	if (!mmc->card || mmc_card_removed(mmc->card) ||
+	    mmc->ios.power_mode != MMC_POWER_ON) {
+		mmc_release_host(mmc);
+		return -ENODEV;
+	}
+	previous = host->y2_clock_limit;
+	WRITE_ONCE(host->y2_clock_limit, limit);
+	ret = msdc_set_mclk(host, mmc->ios.timing, mmc->ios.clock);
+	if (ret) {
+		WRITE_ONCE(host->y2_clock_limit, previous);
+		mmc_release_host(mmc);
+		return ret;
+	}
+	dev_info(dev, "qualification clock cap=%u requested=%u actual=%u timing=%u\n",
+		limit, mmc->ios.clock, mmc->actual_clock, mmc->ios.timing);
+	mmc_release_host(mmc);
+	return count;
+}
