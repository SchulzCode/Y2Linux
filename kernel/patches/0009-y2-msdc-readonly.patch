+ * later request; if restoration also fails, reject I/O before DMA starts. */
+static int y2_msdc_clock_ready(struct msdc_host *host, u32 previous, u32 flags,
+                              int enable_error)
+{
+	struct mmc_host *mmc = mmc_from_priv(host);
+	u32 val;
+	int ret = enable_error, restore;
+
+	if (!ret)
+		ret = readl_poll_timeout(host->base + MSDC_CFG, val,
+					(val & MSDC_CFG_CKSTB), 1, 20000);
+	if (!ret) {
+		host->y2_clock_error = 0;
+		return 0;
+	}
+	if (!enable_error)
+		clk_disable_unprepare(host->src_clk_cg);
+	writel(previous & ~MSDC_CFG_CKPDN, host->base + MSDC_CFG);
+	restore = clk_prepare_enable(host->src_clk_cg);
+	if (!restore)
+		restore = readl_poll_timeout(host->base + MSDC_CFG, val,
+					    (val & MSDC_CFG_CKSTB), 1, 20000);
+	if (previous & MSDC_CFG_CKPDN)
