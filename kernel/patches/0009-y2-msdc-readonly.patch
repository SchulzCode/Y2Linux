+		host->y2_drive_before[1], host->y2_drive_before[2], host->y2_drive_error);
+	n += sysfs_emit_at(buf, n, "fault.total=%u", f->total);
+	for (i = 1; i < Y2_FAULT_KINDS; i++)
+		n += sysfs_emit_at(buf, n, " %s=%u", y2_fault_kind_names[i], f->count[i]);
+	n += sysfs_emit_at(buf, n, " timeouts=%u\n", f->count[Y2_FAULT_CMD_TIMEOUT] + f->count[Y2_FAULT_DATA_TIMEOUT]);
+	n += sysfs_emit_at(buf, n, "fault.lanes: pos=%u,%u,%u,%u,%u,%u,%u,%u neg=%u,%u,%u,%u,%u,%u,%u,%u\n",
+		f->lane_pos[0], f->lane_pos[1], f->lane_pos[2], f->lane_pos[3], f->lane_pos[4],
+		f->lane_pos[5], f->lane_pos[6], f->lane_pos[7], f->lane_neg[0], f->lane_neg[1],
+		f->lane_neg[2], f->lane_neg[3], f->lane_neg[4], f->lane_neg[5], f->lane_neg[6],
+		f->lane_neg[7]);
+	if (f->have_first) {
+		n = y2_diag_fault(buf, n, "first", &f->first);
