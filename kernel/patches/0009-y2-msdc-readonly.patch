+/* Admit exactly one ladder level: never more than DT granted, and the
+ * clock cap follows the level. The next (re)initialisation negotiates it. */
+static void y2_apply_level(struct msdc_host *host, unsigned level)
+{
+	struct mmc_host *mmc = mmc_from_priv(host);
+	const struct y2_storage_level *ladder;
+	unsigned count;
+	u32 caps, caps2;
+
+	ladder = y2_storage_ladder(host->y2_sd, &count);
+	level = min(level, count - 1);
+	y2_level_caps(host->y2_sd, ladder[level].caps, &caps, &caps2);
+	host->y2_level = level;
+	mmc->caps = (mmc->caps & ~Y2_MANAGED_CAPS) | (host->y2_dt_caps & caps);
+	mmc->caps2 = (mmc->caps2 & ~Y2_MANAGED_CAPS2) | (host->y2_dt_caps2 & caps2);
+	WRITE_ONCE(host->y2_clock_limit, min(mmc->f_max, ladder[level].clock_hz));
+	host->y2_level_strikes = 0;
+}
