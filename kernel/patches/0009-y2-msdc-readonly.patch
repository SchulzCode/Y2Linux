+static int y2_verify_emmc(struct msdc_host *host, struct mmc_card *card)
+{
+	u8 *ext;
+	int ret;
+
+	if (!host->y2_ext_id_saved)
+		return -ENODATA;
+	ret = mmc_get_ext_csd(card, &ext);
+	if (ret)
+		return ret;
+	ret = y2_emmc_identity_matches(ext, host->y2_ext_id) ? 0 : -EILSEQ;
+	kfree(ext);
+	return ret;
+}
+
+static int y2_verify_sd(struct msdc_host *host, struct mmc_card *card)
+{
+	u8 *ssr = kzalloc(128, GFP_KERNEL);
+	int ret;
+
+	if (!ssr)
+		return -ENOMEM;
+	ret = mmc_app_sd_status(card, ssr);
+	if (!ret)
+		ret = mmc_app_sd_status(card, ssr + 64);
+	/* Two reads in the negotiated mode must agree and report a 4-bit bus. */
+	if (!ret && (memcmp(ssr, ssr + 64, 64) || (ssr[0] >> 6) != 2))
+		ret = -EILSEQ;
+	kfree(ssr);
+	return ret;
+}
