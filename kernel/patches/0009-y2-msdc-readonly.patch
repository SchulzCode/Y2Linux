+/* Readback in the negotiated mode: the eMMC returns its identification
+ * EXT_CSD identity unchanged; an SD card returns a stable SD Status. A
+ * mismatch is a fallback event and renegotiates one level lower. */
+static void y2_storage_verify(struct work_struct *work)
+{
+	struct msdc_host *host = container_of(to_delayed_work(work), struct msdc_host, y2_verify);
+	struct mmc_host *mmc = mmc_from_priv(host);
+	int ret;
+
+	if (READ_ONCE(host->y2_removing))
+		return;
+	if (__mmc_claim_host(mmc, NULL, &host->y2_recovery_abort))
+		return;
+	if (!mmc->card || mmc_card_removed(mmc->card) || !y2_high_timing(mmc->ios.timing) ||
+	    host->y2_clock_error)
+		goto release;
+	ret = pm_runtime_resume_and_get(host->dev);
+	if (ret < 0)
+		goto release;
+	ret = host->y2_emmc ? y2_verify_emmc(host, mmc->card) : y2_verify_sd(host, mmc->card);
+	if (ret == -ENODATA) {
+		host->y2_verify_result = 0;
+	} else if (ret) {
+		host->y2_verify_result = ret;
+		host->y2_events[Y2_EVENT_VERIFY]++;
+		y2_downgrade(host, Y2_EVENT_VERIFY, true);
+	} else {
+		host->y2_verify_result = 1;
+		host->y2_verified_timing = mmc->ios.timing;
