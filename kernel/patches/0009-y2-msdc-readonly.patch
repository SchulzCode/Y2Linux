+/* Y2 clock enable only, mirroring msdc_gate_clock; absent optional clocks are
+ * NULL. The caller rewrites MSDC_CFG (SD/MMC mode) and then waits for CKSTB. */
+static int msdc_ungate_clock_only(struct msdc_host *host)
+{
+	int ret;
+
+	ret = clk_prepare_enable(host->h_clk);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(host->bus_clk);
+	if (ret)
+		goto h_clk;
+	ret = clk_prepare_enable(host->src_clk);
+	if (ret)
+		goto bus_clk;
+	ret = clk_prepare_enable(host->src_clk_cg);
+	if (ret)
+		goto src_clk;
+	ret = clk_prepare_enable(host->crypto_clk);
+	if (ret)
+		goto src_clk_cg;
+	ret = clk_bulk_prepare_enable(MSDC_NR_CLOCKS, host->bulk_clks);
+	if (ret)
+		goto crypto_clk;
+	return 0;
+crypto_clk:
+	clk_disable_unprepare(host->crypto_clk);
+src_clk_cg:
+	clk_disable_unprepare(host->src_clk_cg);
+src_clk:
+	clk_disable_unprepare(host->src_clk);
+bus_clk:
+	clk_disable_unprepare(host->bus_clk);
+h_clk:
+	clk_disable_unprepare(host->h_clk);
+	return ret;
+}
