+/* Classify a completed data request. Tuning sweeps provoke CRC errors by
+ * design and a command-status -EIO is policy, not transport: neither counts. */
+static int y2_request_fault(u32 opcode, int cmd_error, int data_error)
+{
+	if (mmc_op_tuning(opcode))
+		return -1;
+	if (data_error == -EILSEQ || cmd_error == -EILSEQ)
+		return Y2_EVENT_CRC;
+	if (data_error == -ETIMEDOUT || cmd_error == -ETIMEDOUT)
+		return Y2_EVENT_TIMEOUT;
+	if (data_error == -EIO)
+		return Y2_EVENT_CONTROLLER;
+	return -1;
+}
