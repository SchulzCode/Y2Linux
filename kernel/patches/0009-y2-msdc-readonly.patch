+/* An unanswered CMD55 with no card bound means the slot is empty: the next
+ * card starts again from the ceiling. A card that failed a mode still answers
+ * CMD55 after its power cycle, so it keeps its lower level. */
+static void y2_sd_slot_empty(struct msdc_host *host)
+{
+	if (host->y2_level != host->y2_ceiling) {
+		y2_apply_level(host, host->y2_ceiling);
+		host->y2_verify_result = 0;
+		dev_info(host->dev, "Y2 SD slot empty: next card negotiates from %s\n",
+			 y2_sd_levels[host->y2_ceiling].name);
+	}
+}
+
+/* Record a transport fault and let the claimed worker decide. */
+static void y2_storage_event(struct msdc_host *host, enum y2_storage_event event)
+{
+	host->y2_events[event]++;
+	host->y2_transport_errors++;
+	atomic_set(&host->y2_pending_event, event + 1);
+	if (!READ_ONCE(host->y2_removing))
+		schedule_delayed_work(&host->y2_clock_recovery, 0);
+}
+
+/* Faults are handled only between fully claimed requests; the MMC core owns
+ * request retries and a failed write is never replayed here. */
+static void y2_msdc_clock_recovery(struct work_struct *work)
+{
+	struct msdc_host *host = container_of(to_delayed_work(work), struct msdc_host, y2_clock_recovery);
+	struct mmc_host *mmc = mmc_from_priv(host);
+	int pending, ret;
+	enum y2_storage_event event;
+
+	if (READ_ONCE(host->y2_removing))
+		return;
+	pending = atomic_xchg(&host->y2_pending_event, 0);
+	if (!pending)
+		return;
+	event = pending - 1;
+	if (__mmc_claim_host(mmc, NULL, &host->y2_recovery_abort))
+		return;
+	ret = pm_runtime_resume_and_get(host->dev);
+	if (ret < 0)
+		goto release;
+	/* A tuned mode gets the core's one retune after a CRC or timeout
+	 * (mmc_retune_needed); a second fault in the same level steps down. */
+	if (!host->y2_clock_error &&
+	    ((event != Y2_EVENT_CRC && event != Y2_EVENT_TIMEOUT) ||
+	     !y2_tuned_timing(mmc->ios.timing) || ++host->y2_level_strikes >= 2))
+		y2_downgrade(host, event, true);
+	pm_runtime_mark_last_busy(host->dev);
+	pm_runtime_put_autosuspend(host->dev);
+release:
+	mmc_release_host(mmc);
+}
