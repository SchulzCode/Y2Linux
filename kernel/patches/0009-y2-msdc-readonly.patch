+/* A pending request, DMA, controller/FIFO activity or unserviced interrupt
+ * refuses the gate; the runtime core retries at the next autosuspend expiry. */
+static int y2_msdc_runtime_suspend(struct device *dev, struct mmc_host *mmc,
+				   struct msdc_host *host)
+{
+	enum y2_msdc_rpm_busy busy;
+	unsigned int i;
+
+	busy = y2_msdc_rpm_busy(!!READ_ONCE(host->mrq),
+		readl(host->base + Y2_MSDC_DMA_CFG), readl(host->base + Y2_SDC_STS),
+		readl(host->base + Y2_MSDC_FIFOCS), readl(host->base + Y2_MSDC_INT),
+		readl(host->base + Y2_MSDC_INTEN));
+	if (busy != Y2_MSDC_IDLE) {
+		host->y2_rpm_refused[busy]++;
+		if (host->hsq_en && mmc_hsq_resume(mmc))
+			dev_err(dev, "HSQ rollback failed\n");
+		return -EBUSY;
+	}
+	for (i = 0; i < Y2_MSDC_RETAINED; i++)
+		host->y2_rpm_saved[i] = readl(host->base + y2_msdc_retained[i]);
+	/* Exact stock order: MS mode, then PERI MSDC CG. */
+	writel(host->y2_rpm_saved[0] & ~(Y2_MSDC_CFG_MODE | Y2_MSDC_CFG_VOLATILE),
+	       host->base + Y2_MSDC_CFG);
+	msdc_gate_clock(host);
+	host->y2_rpm_gated = true;
+	host->y2_rpm_suspends++;
+	return 0;
+}
+
+static int y2_msdc_runtime_resume(struct mmc_host *mmc, struct msdc_host *host)
+{
+	u32 now[Y2_MSDC_RETAINED], mismatch, val;
+	unsigned int i;
+	int ret;
+
+	if (!host->y2_rpm_gated)
+		return host->hsq_en ? mmc_hsq_resume(mmc) : 0;
+	ret = msdc_ungate_clock_only(host);
+	if (ret)
+		goto fail;
+	udelay(10);
+	for (i = 0; i < Y2_MSDC_RETAINED; i++)
+		now[i] = readl(host->base + y2_msdc_retained[i]);
+	mismatch = y2_msdc_mismatch(host->y2_rpm_saved, now);
+	if (mismatch) {
+		/* Retention is expected on a clock gate; any loss is restored
+		 * from the MT6582 register image and verified, never guessed. */
+		for (i = 1; i < Y2_MSDC_RETAINED; i++)
+			if (mismatch & BIT(i))
+				writel(host->y2_rpm_saved[i], host->base + y2_msdc_retained[i]);
+		for (i = 0; i < Y2_MSDC_RETAINED; i++)
+			now[i] = readl(host->base + y2_msdc_retained[i]);
+		host->y2_rpm_last_mismatch = mismatch;
+		host->y2_rpm_restored++;
+		if (y2_msdc_mismatch(host->y2_rpm_saved, now)) {
+			ret = -EIO;
+			goto fail;
+		}
+	} else {
+		host->y2_rpm_retained++;
+	}
+	/* SD/MMC mode and the saved divider/mode; stock waits for CKSTB. */
+	writel(y2_msdc_cfg_restore(host->y2_rpm_saved[0]), host->base + Y2_MSDC_CFG);
+	ret = readl_poll_timeout(host->base + Y2_MSDC_CFG, val, val & Y2_MSDC_CFG_CKSTB, 1, 20000);
+	if (ret)
+		goto fail;
+	host->y2_rpm_gated = false;
+	host->y2_rpm_resumes++;
+	host->y2_rpm_error = 0;
+	if (host->hsq_en)
+		mmc_hsq_resume(mmc);
+	return 0;
+fail:
+	/* Leave the clock enabled: a failed resume never re-gates a live host,
+	 * and the runtime core reports the error to every new request. */
+	host->y2_rpm_error = ret;
+	dev_err(host->dev, "Y2 runtime resume failed %d mismatch=%#x\n", ret, host->y2_rpm_last_mismatch);
+	return ret;
+}
