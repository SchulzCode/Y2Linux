+	host->y2_tune_iocon = readl(host->base + MSDC_IOCON);
+	host->y2_tune_pad = readl(host->base + host->dev_comp->pad_tune_reg);
+	host->y2_tune_rddly0 = readl(host->base + Y2_MSDC_DAT_RDDLY0);
+	if (ret) {
+		/* Called by the core with the host claimed, during (re)init or a
+		 * retune: admit only lower modes; the core's retry renegotiates. */
+		host->y2_tuning_failures++;
+		host->y2_events[Y2_EVENT_TUNING]++;
+		y2_downgrade(host, Y2_EVENT_TUNING, false);
 	}
 	return ret;
 }
