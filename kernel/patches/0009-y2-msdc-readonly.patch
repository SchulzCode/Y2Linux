+	case MMC_TIMING_MMC_HS200:
+		return mmc->caps2 & MMC_CAP2_HS200_1_8V_SDR;
+	case MMC_TIMING_MMC_DDR52:
+		return mmc->caps & MMC_CAP_1_8V_DDR;
+	case MMC_TIMING_UHS_SDR104:
+		return mmc->caps & MMC_CAP_UHS_SDR104;
+	case MMC_TIMING_UHS_DDR50:
+		return mmc->caps & MMC_CAP_UHS_DDR50;
+	case MMC_TIMING_UHS_SDR50:
+		return mmc->caps & MMC_CAP_UHS_SDR50;
+	case MMC_TIMING_UHS_SDR12:
+	case MMC_TIMING_UHS_SDR25:
+		return mmc->caps & MMC_CAP_UHS_SDR12;
+	case MMC_TIMING_SD_HS:
+		return mmc->caps & MMC_CAP_SD_HIGHSPEED;
+	case MMC_TIMING_MMC_HS:
+		return mmc->caps & MMC_CAP_MMC_HIGHSPEED;
+	default:
+		return true;
+	}
+}
