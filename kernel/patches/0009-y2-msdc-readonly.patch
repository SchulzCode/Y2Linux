+#define Y2_PATCH0_CKGEN_DLY GENMASK(14, 10)
+
+/* ---- SD tuning (candidate 3) -----------------------------------------------
+ * MT6582 has 32-tap, 5-bit, linear delay lines; mainline sized the sweep from
+ * MMC_CAP2_NO_MMC (64 steps) and wrote the upper half into DAT_RDDLY0 and
+ * past CMDRRDLY into CLKTXDLY. Here every sweep is exactly Y2_TUNE_TAPS wide,
+ * writes only its own field, scans both sampling edges, requires every try of
+ * a tap to pass and records the complete pass maps for diagnostics. */
+static void y2_set_cmd_delay(struct msdc_host *host, unsigned tap)
+{
+	sdr_set_field(host->base + host->dev_comp->pad_tune_reg, MSDC_PAD_TUNE_CMDRDLY,
+		      tap & (Y2_TUNE_TAPS - 1));
+}
+
+static void y2_set_data_delay(struct msdc_host *host, unsigned tap)
+{
+	sdr_set_field(host->base + host->dev_comp->pad_tune_reg, MSDC_PAD_TUNE_DATRRDLY,
+		      tap & (Y2_TUNE_TAPS - 1));
+}
+
+static void y2_set_cmd_int_delay(struct msdc_host *host, unsigned tap)
+{
+	sdr_set_field(host->base + host->dev_comp->pad_tune_reg, MSDC_PAD_TUNE_CMDRRDLY,
+		      tap & (Y2_TUNE_TAPS - 1));
+}
+
+enum y2_sweep_kind { Y2_SWEEP_CMD, Y2_SWEEP_CMD_INT, Y2_SWEEP_DATA };
+
+/* One pass over every tap for one edge. A tap is "all" if every try passed and
+ * "any" if at least one did; a command sweep judges the command only, a data
+ * sweep the whole tuning block. */
+static void y2_tune_sweep(struct msdc_host *host, struct mmc_host *mmc, u32 opcode,
+			  enum y2_sweep_kind kind, unsigned edge, unsigned tries,
+			  struct y2_tune_phase *ph)
+{
+	unsigned tap, attempt, all = 0, any = 0;
+
+	/* The command-internal sweep keeps the response edge already chosen. */
+	if (kind == Y2_SWEEP_DATA) {
+		msdc_set_data_sample_edge(host, !edge);
+	} else if (kind == Y2_SWEEP_CMD) {
+		if (edge)
+			sdr_set_bits(host->base + MSDC_IOCON, MSDC_IOCON_RSPL);
+		else
+			sdr_clr_bits(host->base + MSDC_IOCON, MSDC_IOCON_RSPL);
+	}
+	for (tap = 0; tap < Y2_TUNE_TAPS; tap++) {
+		bool pass_all = true, pass_any = false;
+
+		if (kind == Y2_SWEEP_CMD)
+			y2_set_cmd_delay(host, tap);
+		else if (kind == Y2_SWEEP_CMD_INT)
+			y2_set_cmd_int_delay(host, tap);
+		else
+			y2_set_data_delay(host, tap);
+		for (attempt = 0; attempt < tries; attempt++) {
+			int cmd_error = 0;
+			int err = mmc_send_tuning(mmc, opcode, &cmd_error);
+			bool ok = kind == Y2_SWEEP_DATA ? !err : !cmd_error;
+
+			if (ok)
+				pass_any = true;
+			else
+				pass_all = false;
+		}
+		if (pass_all)
+			all |= BIT(tap);
+		if (pass_any)
+			any |= BIT(tap);
+	}
+	ph->all[edge] = all;
+	ph->any[edge] = any;
+	ph->scanned |= BIT(edge);
+}
+
+static void y2_tune_snapshot(struct msdc_host *host, struct y2_tune_log *log)
+{
+	log->iocon = readl(host->base + MSDC_IOCON);
+	log->pad_tune = readl(host->base + host->dev_comp->pad_tune_reg);
+	log->rddly0 = readl(host->base + Y2_MSDC_DAT_RDDLY0);
+	log->rddly1 = readl(host->base + Y2_MSDC_DAT_RDDLY0 + 4);
+	log->patch0 = readl(host->base + Y2_MSDC_PATCH_BIT0_REG);
+	log->patch1 = readl(host->base + Y2_MSDC_PATCH_BIT1_REG);
+	log->patch2 = readl(host->base + MSDC_PATCH_BIT2);
+}
+
+/* SD tuning: command delay and edge first (the data stage needs a working
+ * command path), then the optional command-internal delay, then the data
+ * read delay and edge. Each stage applies the widest eye over both edges;
+ * a stage without an eye of Y2_TUNE_MIN_WIDTH taps fails the whole tuning and
+ * the ladder steps down instead of running on a guess. */
+static int y2_sd_execute_tuning(struct mmc_host *mmc, u32 opcode)
+{
+	struct msdc_host *host = mmc_priv(mmc);
+	struct y2_tune_log *log = &host->y2_tune_last;
+	u32 saved_iocon = readl(host->base + MSDC_IOCON);
+	u32 saved_pad = readl(host->base + host->dev_comp->pad_tune_reg);
+	int ret = 0;
+	unsigned edge;
+
+	memset(log, 0, sizeof(*log));
+	log->timing = mmc->ios.timing;
+	sdr_set_field(host->base + host->dev_comp->pad_tune_reg, MSDC_PAD_TUNE_CMDRRDLY,
+		      host->hs200_cmd_int_delay & (Y2_TUNE_TAPS - 1));
+	for (edge = 0; edge < Y2_TUNE_EDGES; edge++)
+		y2_tune_sweep(host, mmc, opcode, Y2_SWEEP_CMD, edge, Y2_TUNE_TRIES, &log->cmd);
+	y2_tune_phase_choose(&log->cmd, Y2_TUNE_TAPS);
+	if (!log->cmd.pick.valid) {
+		ret = -EIO;
+		goto out;
+	}
+	if (log->cmd.pick.edge)
+		sdr_set_bits(host->base + MSDC_IOCON, MSDC_IOCON_RSPL);
+	else
+		sdr_clr_bits(host->base + MSDC_IOCON, MSDC_IOCON_RSPL);
+	y2_set_cmd_delay(host, log->cmd.pick.delay);
+
+	/* Command-internal delay: applied only when it proves to carry an eye;
+	 * an all-pass sweep says nothing, so the stock value (0) stays. */
+	y2_tune_sweep(host, mmc, opcode, Y2_SWEEP_CMD_INT, 0, Y2_TUNE_TRIES, &log->cmd_int);
+	y2_tune_phase_choose(&log->cmd_int, Y2_TUNE_TAPS);
+	y2_set_cmd_int_delay(host, log->cmd_int.pick.valid && !log->cmd_int.pick.open ?
+			     log->cmd_int.pick.delay : host->hs200_cmd_int_delay);
+
+	sdr_set_field(host->base + MSDC_PATCH_BIT, MSDC_INT_DAT_LATCH_CK_SEL, host->latch_ck);
+	for (edge = 0; edge < Y2_TUNE_EDGES; edge++)
+		y2_tune_sweep(host, mmc, opcode, Y2_SWEEP_DATA, edge, Y2_TUNE_TRIES, &log->data);
+	y2_tune_phase_choose(&log->data, Y2_TUNE_TAPS);
+	if (!log->data.pick.valid) {
+		ret = -EIO;
+		goto out;
+	}
+	msdc_set_data_sample_edge(host, !log->data.pick.edge);
+	y2_set_data_delay(host, log->data.pick.delay);
+out:
+	if (ret) {
+		/* Never leave a half-swept delay for the next, lower level. */
+		writel(saved_iocon, host->base + MSDC_IOCON);
+		writel(saved_pad, host->base + host->dev_comp->pad_tune_reg);
+	}
+	log->result = ret;
+	log->valid = 1;
+	y2_tune_snapshot(host, log);
+	if (!host->y2_tune_count++)
+		host->y2_tune_first = *log;
+	dev_info(host->dev,
+		 "Y2 SD tuning %s: cmd edge=%u delay=%u eye=%u data edge=%u delay=%u eye=%u open=%u/%u\n",
+		 ret ? "FAILED" : "ok", log->cmd.pick.edge, log->cmd.pick.delay, log->cmd.pick.len,
+		 log->data.pick.edge, log->data.pick.delay, log->data.pick.len,
+		 log->cmd.pick.open, log->data.pick.open);
+	return ret;
+}
+
+/* ---- Candidate 3 diagnostics -------------------------------------------------
+ * y2_storage keeps its one-line contract. These attributes are `key=value`
+ * lines (first '=' or ': ' separates), safe to parse line by line:
+ *   y2_storage_diag  state, registers, pad cells, probe, faults, fallback
+ *   y2_tune_diag     every tuning sweep: pass maps, windows, picks (SD host)
+ */
+static const char *const y2_edge_name[Y2_TUNE_EDGES] = { "rise", "fall" };
+
+static int y2_diag_windows(char *buf, int n, unsigned map)
+{
+	struct y2_tune_window w[Y2_TUNE_MAX_WINDOWS];
+	unsigned found = y2_tune_windows(map, Y2_TUNE_TAPS, Y2_TUNE_CIRCULAR, w, ARRAY_SIZE(w));
+	unsigned i;
+
+	if (!found)
+		n += sysfs_emit_at(buf, n, "none");
+	for (i = 0; i < found && i < ARRAY_SIZE(w); i++)
+		n += sysfs_emit_at(buf, n, "%s%u-%u", i ? "," : "", w[i].start,
+				   w[i].start + w[i].len - 1);
+	return n;
+}
+
+static int y2_diag_phase(char *buf, int n, const char *log, const char *phase,
+			 const struct y2_tune_phase *p)
+{
+	const struct y2_tune_choice *c = &p->pick;
+	unsigned e;
+
+	n += sysfs_emit_at(buf, n,
+		"tune.%s.%s.pick: valid=%u edge=%s delay=%u window=%u-%u eye=%u margin=%u/%u open=%u clipped=%u/%u windows=%u/%u legacy=%u/%u\n",
+		log, phase, c->valid, y2_edge_name[c->edge & 1], c->delay, c->start,
+		c->start + (c->len ? c->len - 1 : 0), c->len, c->margin_lo, c->margin_hi, c->open,
+		c->clipped_lo, c->clipped_hi, c->windows[0], c->windows[1], p->legacy[0], p->legacy[1]);
+	for (e = 0; e < Y2_TUNE_EDGES; e++) {
+		if (!(p->scanned & BIT(e)))
+			continue;
+		n += sysfs_emit_at(buf, n, "tune.%s.%s.%s: all=%08x any=%08x windows=", log, phase,
+				   y2_edge_name[e], p->all[e], p->any[e]);
+		n = y2_diag_windows(buf, n, p->all[e]);
+		n += sysfs_emit_at(buf, n, "\n");
+	}
+	return n;
+}
+
+static int y2_diag_log(char *buf, int n, const char *name, const struct y2_tune_log *log)
+{
+	if (!log->valid)
+		return n + sysfs_emit_at(buf, n, "tune.%s: none\n", name);
+	n += sysfs_emit_at(buf, n,
+		"tune.%s: result=%d timing=%s iocon=%#x pad_tune=%#x rddly0=%#x rddly1=%#x patch0=%#x patch1=%#x patch2=%#x\n",
+		name, log->result, y2_timing_name(log->timing), log->iocon, log->pad_tune,
+		log->rddly0, log->rddly1, log->patch0, log->patch1, log->patch2);
+	n += sysfs_emit_at(buf, n,
+		"tune.%s.regs: cmdrdly=%u cmdrrdly=%u datrrdly=%u datwrdly=%u clktxdly=%u latch_ck=%u ckgen_dly=%u cmd_rsp=%u wrdat_crcs=%u rspl=%u dspl=%u wdspl=%u ddlsel=%u\n",
+		name, y2_pad_tune_cmdrd(log->pad_tune), y2_pad_tune_cmdrr(log->pad_tune),
+		y2_pad_tune_datrd(log->pad_tune), y2_pad_tune_datwr(log->pad_tune),
+		y2_pad_tune_clktx(log->pad_tune), y2_patch0_latch_ck(log->patch0),
+		y2_patch0_ckgen_dly(log->patch0), y2_patch1_cmd_rsp(log->patch1),
+		y2_patch1_wrdat_crcs(log->patch1), !!(log->iocon & MSDC_IOCON_RSPL),
+		!!(log->iocon & MSDC_IOCON_DSPL), !!(log->iocon & MSDC_IOCON_W_DSPL),
+		!!(log->iocon & MSDC_IOCON_DDLSEL));
+	n = y2_diag_phase(buf, n, name, "cmd", &log->cmd);
+	n = y2_diag_phase(buf, n, name, "cmd_int", &log->cmd_int);
+	return y2_diag_phase(buf, n, name, "data", &log->data);
+}
+
+static ssize_t y2_tune_diag_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct msdc_host *host = mmc_priv(dev_get_drvdata(dev));
+	int n = sysfs_emit(buf, "tune.taps=%u tune.circular=%d tune.tries=%u tune.min_eye=%u tune.step=%u tune.count=%u tune.runs=%u tune.failures=%u\n",
+			   Y2_TUNE_TAPS, Y2_TUNE_CIRCULAR, Y2_TUNE_TRIES, Y2_TUNE_MIN_WIDTH,
+			   host->tuning_step, host->y2_tune_count, host->y2_tuning_runs,
+			   host->y2_tuning_failures);
+
+	n = y2_diag_log(buf, n, "first", &host->y2_tune_first);
+	return y2_diag_log(buf, n, "last", &host->y2_tune_last);
+}
+static DEVICE_ATTR_RO(y2_tune_diag);
