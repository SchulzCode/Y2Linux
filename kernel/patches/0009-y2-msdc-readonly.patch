+/* Step down the ladder. With `may_reset` (caller owns the claimed host and
+ * no core initialisation is in progress) a card whose current timing is no
+ * longer admitted is renegotiated immediately with mmc_hw_reset(): the
+ * filesystem never keeps running on a mode that failed. Without it (called
+ * from inside the core's own initialisation) only the admitted modes change
+ * and the core's retry negotiates below. Each step only ever moves down. */
+static void y2_downgrade(struct msdc_host *host, enum y2_storage_event event, bool may_reset)
+{
+	struct mmc_host *mmc = mmc_from_priv(host);
+	const struct y2_storage_level *ladder;
+	unsigned count, guard, from = host->y2_level;
+	int ret = 0;
+
+	ladder = y2_storage_ladder(host->y2_sd, &count);
+	for (guard = 0; guard < count; guard++) {
+		unsigned next = y2_storage_fallback(host->y2_sd, host->y2_level, event);
+
+		if (next == host->y2_level)
+			break;	/* lowest level: the core's own error handling remains */
+		y2_apply_level(host, next);
+		host->y2_clock_fallbacks++;
+		host->y2_verify_result = 0;
+		if (!may_reset || !mmc->card || mmc_card_removed(mmc->card) ||
+		    mmc->ios.power_mode != MMC_POWER_ON)
+			break;
+		if (y2_timing_admitted(mmc, mmc->ios.timing)) {
+			/* Same timing, lower clock: no renegotiation needed. */
+			ret = msdc_set_mclk(host, mmc->ios.timing, mmc->ios.clock);
+			if (ret)
+				host->y2_clock_error = ret;
+			break;
+		}
+		host->y2_resets++;
+		ret = mmc_hw_reset(mmc->card);
+		host->y2_reset_error = ret;
+		if (!ret)
+			break;
+		event = Y2_EVENT_CONTROLLER;	/* failed in the lower mode too */
+	}
+	dev_warn(host->dev, "Y2 storage fallback %s -> %s (%s) cap=%u actual=%u timing=%s ret=%d\n",
+		 ladder[from].name, ladder[host->y2_level].name, y2_storage_event_names[event],
+		 host->y2_clock_limit, mmc->actual_clock, y2_timing_name(mmc->ios.timing), ret);
+}
