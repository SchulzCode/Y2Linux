+/* MMC core capabilities admitted by one ladder level. */
+static void y2_level_caps(bool sd, unsigned level_caps, u32 *caps, u32 *caps2)
+{
+	*caps = 0;
+	*caps2 = 0;
+	if (sd) {
+		if (level_caps & Y2_CAP_HS)
+			*caps |= MMC_CAP_SD_HIGHSPEED;
+		if (level_caps & Y2_CAP_UHS)
