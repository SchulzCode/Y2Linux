+  host->y2_clock_limit, mmc_from_priv(host)->actual_clock, host->y2_transport_errors,
+  host->y2_clock_fallbacks, host->y2_clock_error);
+}
+static DEVICE_ATTR_RO(y2_performance);
+/* Counters only: reading this attribute never touches a gated controller. */
+static ssize_t y2_runtime_pm_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+ struct msdc_host *host = mmc_priv(dev_get_drvdata(dev));
+ int n = sysfs_emit(buf, "gated=%u suspends=%u resumes=%u retained=%u restored=%u last_mismatch=%#x error=%d",
+  READ_ONCE(host->y2_rpm_gated), host->y2_rpm_suspends, host->y2_rpm_resumes,
+  host->y2_rpm_retained, host->y2_rpm_restored, host->y2_rpm_last_mismatch, host->y2_rpm_error);
+ unsigned int i;
+ for (i = 1; i < Y2_MSDC_BUSY_REASONS; i++)
