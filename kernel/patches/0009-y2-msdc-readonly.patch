+#if Y2_MSDC_LAB
+/* ---- Characterization interface (SD host, diagnostic candidates only) -------
+ * Commands (one per write; unmount the card first, a marginal point can fail
+ * reads):
+ *   set name=value ...   write one register field (names below) or a pad
+ *                        drive/slew (drv_clk|drv_cmd|drv_dat|sr_clk|sr_cmd|sr_dat)
+ *   scan [tries=N] [latchck=L] [ckgen=C]
+ *                        sweep every tap on both edges for command and data at
+ *                        the given PATCH_BIT0 fields; the registers are
+ *                        restored afterwards
+ *   retune               run the production SD tuning again
+ *   level NAME           renegotiate the card at ladder level NAME
+ * Reading shows the last command status, the last scan and the registers. */
+struct y2_lab_field {
+	const char *name;
+	unsigned reg, shift, bits;
+};
+static const struct y2_lab_field y2_lab_fields[] = {
+	{ "cmdrdly", MSDC_PAD_TUNE, 16, 5 }, { "cmdrrdly", MSDC_PAD_TUNE, 22, 5 },
+	{ "datrrdly", MSDC_PAD_TUNE, 8, 5 }, { "datwrdly", MSDC_PAD_TUNE, 0, 5 },
+	{ "clktxdly", MSDC_PAD_TUNE, 27, 5 },
+	{ "rspl", MSDC_IOCON, 1, 1 }, { "dspl", MSDC_IOCON, 2, 1 },
+	{ "ddlsel", MSDC_IOCON, 3, 1 }, { "wdspl", MSDC_IOCON, 8, 1 },
+	{ "latchck", MSDC_PATCH_BIT, 7, 3 }, { "ckgen", MSDC_PATCH_BIT, 10, 5 },
+	{ "wrcrcs", MSDC_PATCH_BIT1, 0, 3 }, { "cmdta", MSDC_PATCH_BIT1, 3, 3 },
+	{ "rddly0", Y2_MSDC_DAT_RDDLY0, 0, 32 }, { "rddly1", Y2_MSDC_DAT_RDDLY0 + 4, 0, 32 },
+};
+static const struct { const char *name; unsigned line; bool slew; } y2_lab_pads[] = {
+	{ "drv_clk", 0, false }, { "drv_cmd", 1, false }, { "drv_dat", 2, false },
+	{ "sr_clk", 0, true }, { "sr_cmd", 1, true }, { "sr_dat", 2, true },
+};
+
+static int y2_lab_set(struct msdc_host *host, char *args)
+{
+	char *item;
+
+	while (args && (item = strsep(&args, " "))) {
+		char *eq = strchr(item, '=');
+		unsigned value, i;
+		bool done = false;
+
+		if (!*item)
+			continue;
+		if (!eq || kstrtouint(eq + 1, 0, &value))
+			return -EINVAL;
+		*eq = 0;
+		for (i = 0; i < ARRAY_SIZE(y2_lab_fields); i++) {
+			const struct y2_lab_field *f = &y2_lab_fields[i];
+			u32 mask = f->bits >= 32 ? 0xffffffffU : (BIT(f->bits) - 1) << f->shift;
+			u32 reg;
+
+			if (strcmp(item, f->name))
+				continue;
+			if (f->bits < 32 && value >= BIT(f->bits))
+				return -ERANGE;
+			reg = readl(host->base + f->reg);
+			reg = (reg & ~mask) | ((value << f->shift) & mask);
+			writel(reg, host->base + f->reg);
+			done = true;
+			break;
+		}
+		for (i = 0; !done && i < ARRAY_SIZE(y2_lab_pads); i++) {
+			if (strcmp(item, y2_lab_pads[i].name))
+				continue;
+			if (value > (y2_lab_pads[i].slew ? 1U : 7U))
+				return -ERANGE;
+			if (y2_msdc_pad_set(1, y2_lab_pads[i].line, y2_lab_pads[i].slew ? -1 : (int)value,
+					    y2_lab_pads[i].slew ? (int)value : -1))
+				return -EIO;
+			done = true;
+		}
+		if (!done)
+			return -ENOENT;
+	}
+	return 0;
+}
+
+static int y2_lab_scan(struct msdc_host *host, struct mmc_host *mmc, char *args)
+{
+	struct y2_lab_scan *scan = &host->y2_lab_scan;
+	u32 saved_iocon = readl(host->base + MSDC_IOCON);
+	u32 saved_pad = readl(host->base + host->dev_comp->pad_tune_reg);
+	u32 saved_p0 = readl(host->base + MSDC_PATCH_BIT);
+	unsigned tries = Y2_TUNE_TRIES, latch = y2_patch0_latch_ck(saved_p0);
+	unsigned ckgen = y2_patch0_ckgen_dly(saved_p0), edge;
+	char *item;
+
+	while (args && (item = strsep(&args, " "))) {
+		char *eq = strchr(item, '=');
+		unsigned value;
+
+		if (!*item)
+			continue;
+		if (!eq || kstrtouint(eq + 1, 0, &value))
+			return -EINVAL;
+		*eq = 0;
+		if (!strcmp(item, "tries") && value >= 1 && value <= 16)
+			tries = value;
+		else if (!strcmp(item, "latchck") && value < 8)
+			latch = value;
+		else if (!strcmp(item, "ckgen") && value < 32)
+			ckgen = value;
+		else
+			return -EINVAL;
+	}
+	if (!y2_tuned_timing(mmc->ios.timing))
+		return -EINVAL;
+	memset(scan, 0, sizeof(*scan));
+	sdr_set_field(host->base + MSDC_PATCH_BIT, MSDC_INT_DAT_LATCH_CK_SEL, latch);
+	sdr_set_field(host->base + MSDC_PATCH_BIT, Y2_PATCH0_CKGEN_DLY, ckgen);
+	for (edge = 0; edge < Y2_TUNE_EDGES; edge++)
+		y2_tune_sweep(host, mmc, MMC_SEND_TUNING_BLOCK, Y2_SWEEP_CMD, edge, tries, &scan->cmd);
+	/* The data stage needs the command setting that was in effect. */
+	writel(saved_iocon, host->base + MSDC_IOCON);
+	writel(saved_pad, host->base + host->dev_comp->pad_tune_reg);
+	for (edge = 0; edge < Y2_TUNE_EDGES; edge++)
+		y2_tune_sweep(host, mmc, MMC_SEND_TUNING_BLOCK, Y2_SWEEP_DATA, edge, tries, &scan->data);
+	writel(saved_iocon, host->base + MSDC_IOCON);
+	writel(saved_pad, host->base + host->dev_comp->pad_tune_reg);
+	writel(saved_p0, host->base + MSDC_PATCH_BIT);
+	scan->valid = true;
+	scan->latch = latch;
+	scan->ckgen = ckgen;
+	scan->tries = tries;
+	return 0;
+}
+
+static int y2_lab_level(struct msdc_host *host, struct mmc_host *mmc, char *name)
+{
+	int level = name ? y2_storage_level_named(1, name) : -1;
+	int ret;
+
+	if (level < 0)
+		return -EINVAL;
+	y2_apply_level(host, level);
+	host->y2_verify_result = 0;
+	host->y2_resets++;
+	ret = mmc_hw_reset(mmc->card);
+	host->y2_reset_error = ret;
+	return ret;
+}
+
+static ssize_t y2_lab_store(struct device *dev, struct device_attribute *attr,
+			    const char *buf, size_t count)
+{
+	struct mmc_host *mmc = dev_get_drvdata(dev);
+	struct msdc_host *host = mmc_priv(mmc);
+	char line[160], *args, *command;
+	int ret;
+
+	if (!count || count >= sizeof(line))
+		return -E2BIG;
+	memcpy(line, buf, count);
+	line[count] = 0;
+	args = strim(line);
+	command = strsep(&args, " ");
+	mmc_claim_host(mmc);
+	if (!mmc->card || mmc_card_removed(mmc->card) || mmc->ios.power_mode != MMC_POWER_ON) {
+		ret = -ENODEV;
+		goto out;
+	}
+	ret = pm_runtime_resume_and_get(host->dev);
+	if (ret < 0)
+		goto out;
+	if (!strcmp(command, "set"))
+		ret = y2_lab_set(host, args);
+	else if (!strcmp(command, "scan"))
+		ret = y2_lab_scan(host, mmc, args);
+	else if (!strcmp(command, "retune"))
+		ret = y2_sd_execute_tuning(mmc, MMC_SEND_TUNING_BLOCK);
+	else if (!strcmp(command, "level"))
+		ret = y2_lab_level(host, mmc, args);
+	else
+		ret = -EINVAL;
+	pm_runtime_mark_last_busy(host->dev);
+	pm_runtime_put_autosuspend(host->dev);
+out:
+	host->y2_lab_status = ret;
+	mmc_release_host(mmc);
+	return ret ? ret : count;
+}
