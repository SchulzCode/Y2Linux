+static ssize_t y2_clock_limit_hz_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct mmc_host *mmc = dev_get_drvdata(dev);
+	struct msdc_host *host = mmc_priv(mmc);
