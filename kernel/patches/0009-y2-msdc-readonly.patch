+static ssize_t y2_lab_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct msdc_host *host = mmc_priv(dev_get_drvdata(dev));
+	const struct y2_lab_scan *scan = &host->y2_lab_scan;
+	unsigned e;
+	int n = sysfs_emit(buf, "lab.status=%d lab.scan_valid=%d scan.latchck=%u scan.ckgen=%u scan.tries=%u\n",
+			   host->y2_lab_status, scan->valid, scan->latch, scan->ckgen, scan->tries);
+
+	if (!scan->valid)
+		return n;
+	for (e = 0; e < Y2_TUNE_EDGES; e++) {
+		n += sysfs_emit_at(buf, n, "scan.cmd.%s: all=%08x any=%08x windows=", y2_edge_name[e],
+				   scan->cmd.all[e], scan->cmd.any[e]);
+		n = y2_diag_windows(buf, n, scan->cmd.all[e]);
+		n += sysfs_emit_at(buf, n, "\n");
+	}
+	for (e = 0; e < Y2_TUNE_EDGES; e++) {
+		n += sysfs_emit_at(buf, n, "scan.data.%s: all=%08x any=%08x windows=", y2_edge_name[e],
+				   scan->data.all[e], scan->data.any[e]);
+		n = y2_diag_windows(buf, n, scan->data.all[e]);
+		n += sysfs_emit_at(buf, n, "\n");
+	}
+	return n;
+}
+static DEVICE_ATTR(y2_lab, 0600, y2_lab_show, y2_lab_store);
