+/* Lower the standard SDR ceiling only between fully claimed requests.
+ * The MMC core owns retries; a failed write is never replayed here. */
+static void y2_msdc_clock_recovery(struct work_struct *work)
+{
+ struct msdc_host *host = container_of(to_delayed_work(work), struct msdc_host, y2_clock_recovery);
+ struct mmc_host *mmc = mmc_from_priv(host);
+ u32 limit;
+ int ret;
+ if (READ_ONCE(host->y2_removing)) return;
+ if (__mmc_claim_host(mmc, NULL, &host->y2_recovery_abort)) return;
+ ret = pm_runtime_resume_and_get(host->dev);
+ if (ret < 0) goto release;
+ limit = host->y2_clock_limit > 25000000 ? 25000000 : 13000000;
+ if (limit < host->y2_clock_limit && !host->y2_clock_error) {
+  host->y2_clock_limit = limit;
+  ret = msdc_set_mclk(host, mmc->ios.timing, mmc->ios.clock);
+  if (ret) host->y2_clock_error = ret;
+  else host->y2_clock_fallbacks++;
+  dev_warn(host->dev, "Y2 SDR fallback cap=%u actual=%u error=%d\n", limit, mmc->actual_clock, ret);
+ }
+ pm_runtime_mark_last_busy(host->dev);
+ pm_runtime_put_autosuspend(host->dev);
+release:
+ mmc_release_host(mmc);
 }
 
