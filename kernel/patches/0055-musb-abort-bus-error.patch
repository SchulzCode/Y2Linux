--- a/drivers/usb/musb/musbhsdma.c
+++ b/drivers/usb/musb/musbhsdma.c
@@ -227,7 +227,8 @@
 	int offset;
 	u16 csr;
 
-	if (channel->status == MUSB_DMA_STATUS_BUSY) {
+	if (channel->status == MUSB_DMA_STATUS_BUSY ||
+	    channel->status == MUSB_DMA_STATUS_BUS_ABORT) {
 		if (musb_channel->transmit) {
 			offset = musb->io.ep_offset(musb_channel->epnum,
 						MUSB_TXCSR);
@@ -263,6 +264,38 @@
 	return 0;
 }
 
+#if IS_ENABLED(CONFIG_Y2_PLATFORM)
+/* Y2 multi-packet receive (musb_gadget.c): bytes the engine has written to
+ * memory since the channel was programmed (address register), the programmed
+ * length and the count register (bytes still to go). Called under musb->lock
+ * while the channel is busy. */
+u32 y2_hsdma_moved(struct dma_channel *channel, u32 *len, u32 *left);
+u32 y2_hsdma_moved(struct dma_channel *channel, u32 *len, u32 *left)
+{
+	struct musb_dma_channel *musb_channel = channel->private_data;
+	void __iomem *mbase = musb_channel->controller->base;
+
+	*len = musb_channel->len;
+	*left = musb_read_hsdma_count(mbase, musb_channel->idx);
+	return musb_read_hsdma_addr(mbase, musb_channel->idx)
+		- musb_channel->start_addr;
+}
+
+/* Stop the engine (channel control off) and return the bytes it had written
+ * by then; channel_abort() must still follow. Under musb->lock, channel busy. */
+u32 y2_hsdma_stop(struct dma_channel *channel);
+u32 y2_hsdma_stop(struct dma_channel *channel)
+{
+	struct musb_dma_channel *musb_channel = channel->private_data;
+	void __iomem *mbase = musb_channel->controller->base;
+
+	musb_writew(mbase,
+		MUSB_HSDMA_CHANNEL_OFFSET(musb_channel->idx, MUSB_HSDMA_CONTROL), 0);
+	return musb_read_hsdma_addr(mbase, musb_channel->idx)
+		- musb_channel->start_addr;
+}
+#endif
