--- a/drivers/mmc/core/block.c
+++ b/drivers/mmc/core/block.c
@@ -42,6 +42,9 @@
 #include <linux/idr.h>
 #include <linux/debugfs.h>
 #include <linux/rpmb.h>
+#include <linux/of.h>
+
+#include "/project/kernel/platform/storage-layout.h"
 
 #include <linux/mmc/ioctl.h>
 #include <linux/mmc/card.h>
@@ -2676,6 +2679,15 @@
 			<< (card->csd.read_blkbits - 9);
 	}
 
+	/* Match the stock Y2 main-disk window; the host translates its block
+	 * commands. Never change EXT_CSD or another host/hardware partition. */
+	if (of_device_is_compatible(mmc_dev(card->host)->of_node, "innioasis,y2-mmc")) {
+		if (!mmc_card_mmc(card) || !mmc_card_blockaddr(card) ||
+		    size != Y2_EMMC_RAW_SECTORS)
+			return ERR_PTR(-ENODEV);
+		size = Y2_EMMC_DISK_SECTORS;
+	}
+
 	return mmc_blk_alloc_req(card, &card->dev, size, false, NULL,
 					MMC_BLK_DATA_AREA_MAIN, 0);
 }
