+		 "%s pwdn=%02x det=%02x hpstat=%02x load1=%02x loadstat=%02x mask4=%02x out=%02x classh=%02x\n",
+		 when, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
