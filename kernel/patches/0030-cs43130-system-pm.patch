+/*
+ * Y2: a failed switch must not leave mclk_int_src naming a clock that never
+ * started (upstream set it first, so hw_free's RCO request was skipped).
+ * Run from RCO with XTAL and PLL off, as after hw_free, and report it.
+ */
+static int y2_clksrc_failed(struct snd_soc_component *component, int ret)
+{
+	struct cs43130_private *cs43130 = snd_soc_component_get_drvdata(component);
+
+	if (cs43130->mclk_int_src != CS43130_MCLK_SRC_RCO) {
+		cs43130_change_clksrc(component, CS43130_MCLK_SRC_RCO);
+	} else {
+		regmap_update_bits(cs43130->regmap, CS43130_PWDN_CTL,
+				   CS43130_PDN_XTAL_MASK,
+				   1 << CS43130_PDN_XTAL_SHIFT);
+		regmap_update_bits(cs43130->regmap, CS43130_PWDN_CTL,
+				   CS43130_PDN_PLL_MASK,
+				   1 << CS43130_PDN_PLL_SHIFT);
+	}
+	return ret;
+}
