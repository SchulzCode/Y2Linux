+		 * configuration) settle and see the jack before measuring. */
+		regmap_write(cs43130->regmap, CS43130_HP_DETECT, Y2_HP_DETECT_STOCK);
+		ret = regmap_read_poll_timeout(cs43130->regmap, CS43130_HP_STATUS,
