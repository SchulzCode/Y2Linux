+	return y2_hp_level_set(snd_soc_component_get_drvdata(component),
+			       ucontrol->value.enumerated.item[0]);
+}
+
+static int y2_hp_live_get(struct snd_kcontrol *kcontrol,
+			  struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_soc_kcontrol_component(kcontrol);
+
+	ucontrol->value.enumerated.item[0] =
+		y2_hp_level_live(snd_soc_component_get_drvdata(component));
+	return 0;
+}
