+/*
+ * Y2: headphone load measurement on demand. The Y2 powers the codec only
+ * while it is used and has no codec interrupt wired, so measurement runs on
+ * request (never during playback) and polls the HPLOAD status. It reports the
+ * load; the output level stays the requested one (hp_gain or the ALSA control
+ * "HP Output Level"), written again after the measurement's own choice.
+ */
+static const char *const y2_hp_gain_names[] = { "low", "mid", "high" };
+static DEFINE_MUTEX(y2_hp_lock);
+
+static ssize_t hp_gain_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	struct cs43130_private *cs43130 = dev_get_drvdata(dev);
+	unsigned int live = y2_hp_level_live(cs43130), reg = 0;
+
+	if (live < Y2_HP_LEVELS)
+		return sysfs_emit(buf, "%s\n", y2_hp_gain_names[live]);
+	regmap_read(cs43130->regmap, CS43130_HP_OUT_CTL_1, &reg);
+	return sysfs_emit(buf, "raw:%02x\n", reg);
+}
+
+static ssize_t hp_gain_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct cs43130_private *cs43130 = dev_get_drvdata(dev);
+	int i = sysfs_match_string(y2_hp_gain_names, buf);
+
+	if (i < 0)
+		return -EINVAL;
+	i = y2_hp_level_set(cs43130, i);
+	return i < 0 ? i : count;
+}
+static DEVICE_ATTR_RW(hp_gain);
+
+/* Stock Y2 HP_DETECT (cs43131_hw_init writes 0x0D0000 = 0xCA); upstream 0xC4. */
+#define Y2_HP_DETECT_STOCK	0xCA
+#define Y2_HP_STATUS_PLUGGED	BIT(6)
+static char y2_hp_debug[256];
+
+static void y2_hp_snapshot(struct cs43130_private *cs43130, const char *when)
+{
+	static const unsigned int regs[] = {
+		CS43130_PWDN_CTL, CS43130_HP_DETECT, CS43130_HP_STATUS,
+		CS43130_HP_LOAD_1, CS43130_HP_LOAD_STAT, CS43130_INT_MASK_4,
+		CS43130_HP_OUT_CTL_1, CS43130_CLASS_H_CTL,
+	};
+	unsigned int v[ARRAY_SIZE(regs)] = {};
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++)
+		regmap_read(cs43130->regmap, regs[i], &v[i]);
+	snprintf(y2_hp_debug, sizeof(y2_hp_debug),
+		 "%s pwdn=%02x det=%02x hpstat=%02x load1=%02x loadstat=%02x mask4=%02x out=%02x classh=%02x\n",
+		 when, v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+	dev_info(cs43130->dev, "Y2 HP %s", y2_hp_debug);
+}
+
+static ssize_t hpload_measure_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct cs43130_private *cs43130 = dev_get_drvdata(dev);
+	unsigned int status = 0;
+	int ret;
+
+	if (!cs43130->component || !cs43130->mclk)
+		return -ENODEV;
+	mutex_lock(&y2_hp_lock);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		goto unlock;
+	mutex_lock(&cs43130->clk_mutex);
+	ret = cs43130->clk_req ? -EBUSY : 0; /* a stream owns the clocks */
+	mutex_unlock(&cs43130->clk_mutex);
+	if (!ret) {
+		/* The codec was powered from off: let its plug detector (stock
+		 * configuration) settle and see the jack before measuring. */
+		regmap_write(cs43130->regmap, CS43130_HP_DETECT, Y2_HP_DETECT_STOCK);
+		ret = regmap_read_poll_timeout(cs43130->regmap, CS43130_HP_STATUS,
+					       status, status & Y2_HP_STATUS_PLUGGED,
+					       10 * 1000, 1000 * 1000);
+		y2_hp_snapshot(cs43130, ret ? "no-plug" : "plugged");
+		if (ret) {
+			ret = -ENXIO; /* nothing in the jack, per the detector */
+		} else {
+			cs43130_imp_meas(&cs43130->work);
+			/* imp_meas wrote its load-based hv_seq; PDN_HP is set. */
+			mutex_lock(&y2_hp_level_lock);
+			y2_hp_level_write(cs43130);
+			mutex_unlock(&y2_hp_level_lock);
+			if (!cs43130->hpload_done) {
+				y2_hp_snapshot(cs43130, "failed");
+				ret = -EIO;
+			}
+		}
+	}
+	pm_runtime_put(dev);
+unlock:
+	mutex_unlock(&y2_hp_lock);
+	return ret < 0 ? ret : count;
+}
+static DEVICE_ATTR_WO(hpload_measure);
