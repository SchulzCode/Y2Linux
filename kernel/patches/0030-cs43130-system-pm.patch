+static int y2_hp_level_get(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	mutex_lock(&y2_hp_level_lock);
+	ucontrol->value.enumerated.item[0] = y2_hp_level;
+	mutex_unlock(&y2_hp_level_lock);
+	return 0;
+}
+
+static int y2_hp_level_put(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *component = snd_soc_kcontrol_component(kcontrol);
