+/*
+ * Y2: DAIs holding a clock request (bit = DAI id), under clk_mutex. ALSA
+ * calls hw_free after a failed hw_params and may repeat hw_params without
+ * hw_free, so a bare counter could drift and skip the clock setup (or the
+ * return to RCO) for every later stream.
+ */
+static unsigned long y2_clk_holders;
+
+/* Caller holds clk_mutex. */
+static void y2_clk_put(struct snd_soc_component *component, int dai_id)
+{
+	struct cs43130_private *cs43130 = snd_soc_component_get_drvdata(component);
+
+	if (!test_and_clear_bit(dai_id, &y2_clk_holders))
+		return;
+	cs43130->clk_req--;
+	if (!cs43130->clk_req) {
+		/* no DAI is currently using clk */
+		cs43130_change_clksrc(component, CS43130_MCLK_SRC_RCO);
+		cs43130_pcm_dsd_mix(false, cs43130->regmap);
+	}
+}
+
+/* A failed clock start fails hw_params (-ETIMEDOUT) instead of playing silence. */
+static int y2_clk_get(struct snd_soc_component *component, int dai_id,
+		      unsigned int rate)
+{
+	struct cs43130_private *cs43130 = snd_soc_component_get_drvdata(component);
+	unsigned int required_clk;
+	int ret = 0;
+
+	if (!(CS43130_MCLK_22M % rate))
+		required_clk = CS43130_MCLK_22M;
+	else
+		required_clk = CS43130_MCLK_24M;
+
+	mutex_lock(&cs43130->clk_mutex);
+	if (test_bit(dai_id, &y2_clk_holders)) {
+		/* A repeated hw_params: keep a running clock that fits the rate. */
+		if (required_clk == cs43130->mclk_int)
+			goto unlock;
+		y2_clk_put(component, dai_id);
+	}
+	if (!cs43130->clk_req) {
+		/* no DAI is currently using clk */
+		cs43130_set_pll(component, 0, 0, cs43130->mclk, required_clk);
+		ret = cs43130_change_clksrc(component, cs43130->pll_bypass ?
+					    CS43130_MCLK_SRC_EXT :
+					    CS43130_MCLK_SRC_PLL);
+	}
+	if (!ret) {
+		set_bit(dai_id, &y2_clk_holders);
+		cs43130->clk_req++;
+		if (cs43130->clk_req == 2)
+			cs43130_pcm_dsd_mix(true, cs43130->regmap);
+	}
+unlock:
+	mutex_unlock(&cs43130->clk_mutex);
+	return ret;
+}
