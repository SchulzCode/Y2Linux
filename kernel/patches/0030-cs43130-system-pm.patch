+/*
+ * Y2: start the crystal. Without an IRQ line the ready flag is polled; a
+ * restart within milliseconds of hw_free powering it down (Reborn reopens
+ * the stream on every EQ change) sometimes missed the 100 ms budget, and
+ * the stream then played on the wrong clock: silence with a moving
+ * position (#48). Power it down, rest, and give a second try more time.
+ */
+static int y2_xtal_start(struct cs43130_private *cs43130)
+{
+	static const int budget_ms[] = { 100, 300 };
+	unsigned int i;
+	int ret = 0;
+
+	for (i = 0; i < ARRAY_SIZE(budget_ms); i++) {
+		if (i) {
+			regmap_update_bits(cs43130->regmap, CS43130_PWDN_CTL,
+					   CS43130_PDN_XTAL_MASK,
+					   1 << CS43130_PDN_XTAL_SHIFT);
+			usleep_range(5000, 6000);
+		}
+		reinit_completion(&cs43130->xtal_rdy);
+		regmap_update_bits(cs43130->regmap, CS43130_INT_MASK_1,
+				   CS43130_XTAL_RDY_INT_MASK, 0);
+		regmap_update_bits(cs43130->regmap, CS43130_PWDN_CTL,
+				   CS43130_PDN_XTAL_MASK, 0);
+		ret = cs43130_wait_for_completion(cs43130, &cs43130->xtal_rdy,
+						  budget_ms[i]);
+		regmap_update_bits(cs43130->regmap, CS43130_INT_MASK_1,
+				   CS43130_XTAL_RDY_INT_MASK,
+				   1 << CS43130_XTAL_RDY_INT_SHIFT);
+		if (!ret) {
+			if (i)
+				dev_warn(cs43130->dev, "XTAL ready on retry %u\n", i);
+			return 0;
+		}
+		dev_err(cs43130->dev, "Error waiting for XTAL_READY interrupt: %d (try %u)\n",
+			ret, i + 1);
+	}
+	return ret;
+}
