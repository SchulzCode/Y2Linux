+/*
+ * Y2: headphone output level (HP_OUT_CTL_1 OUT_FS, full scale 1.0, 1.41 or
+ * 1.73 Vrms), paired with the HV_EN choice of upstream's load-based hv_seq:
+ * CLASS_H 0x1C (HV_EN off) for Low, 0x1E for Medium and High. Stock drives
+ * headphones at Low. The datasheet allows OUT_FS changes only while PDN_HP is
+ * set, so a level chosen during playback waits for the next HP power-up (the
+ * card ignores pmdown_time: the amplifier powers down when a stream closes).
+ * The requested level lives here, not in the regcache, and is written before
+ * every power-up, so it survives runtime and system suspend.
+ */
+#define Y2_HP_OUT_FS_MASK	0x30
+#define Y2_CLASS_H_HV_EN	0x02
+#define Y2_HP_LEVELS		3
+static const u8 y2_hp_out_fs[Y2_HP_LEVELS] = { 0x10, 0x20, 0x30 };
+static const u8 y2_hp_hv_en[Y2_HP_LEVELS] = { 0, Y2_CLASS_H_HV_EN, Y2_CLASS_H_HV_EN };
+static unsigned int y2_hp_level;	/* Low */
+static DEFINE_MUTEX(y2_hp_level_lock);
+
+/* Caller holds y2_hp_level_lock and knows PDN_HP is set. */
+static int y2_hp_level_write(struct cs43130_private *cs43130)
+{
+	int ret;
+
+	ret = regmap_update_bits(cs43130->regmap, CS43130_CLASS_H_CTL,
+				 Y2_CLASS_H_HV_EN, y2_hp_hv_en[y2_hp_level]);
+	if (ret)
+		return ret;
+	return regmap_update_bits(cs43130->regmap, CS43130_HP_OUT_CTL_1,
+				  Y2_HP_OUT_FS_MASK, y2_hp_out_fs[y2_hp_level]);
+}
+
+/* DAPM clears PDN_HP under the card's DAPM mutex, right after the "HiFi DAC"
+ * PRE_PMU has written the level. Holding it makes a PDN_HP check and the
+ * write after it one step. NULL before the card binds: nothing can power the
+ * amplifier then. Lock order: DAPM mutex, then y2_hp_level_lock. */
+static struct snd_soc_card *y2_hp_dapm_lock(struct cs43130_private *cs43130)
+{
+	struct snd_soc_card *card = cs43130->component ? cs43130->component->card : NULL;
+
+	if (card)
+		snd_soc_dapm_mutex_lock(card);
+	return card;
+}
+
+static void y2_hp_dapm_unlock(struct snd_soc_card *card)
+{
+	if (card)
+		snd_soc_dapm_mutex_unlock(card);
+}
+
+/* Request a level: written now while the amplifier is down, otherwise at its
+ * next power-up. Returns 1 when the request changed. */
+static int y2_hp_level_set(struct cs43130_private *cs43130, unsigned int level)
+{
+	struct snd_soc_card *card;
+	unsigned int pwdn;
+	int changed, ret = 0;
+
+	if (level >= Y2_HP_LEVELS)
+		return -EINVAL;
+	card = y2_hp_dapm_lock(cs43130);
+	mutex_lock(&y2_hp_level_lock);
+	changed = y2_hp_level != level;
+	y2_hp_level = level;
+	/* An unreadable state counts as powered: never write a live amplifier. */
+	if (!regmap_read(cs43130->regmap, CS43130_PWDN_CTL, &pwdn) &&
+	    (pwdn & CS43130_PDN_HP_MASK))
+		ret = y2_hp_level_write(cs43130);
+	mutex_unlock(&y2_hp_level_lock);
+	y2_hp_dapm_unlock(card);
+	return ret ? ret : changed;
+}
+
+/* The level the output runs at (or will run at when it powers up next):
+ * 0..2, or Y2_HP_LEVELS when the registers hold another combination. */
+static unsigned int y2_hp_level_live(struct cs43130_private *cs43130)
+{
+	unsigned int out = 0, class_h = 0, i;
+
+	if (regmap_read(cs43130->regmap, CS43130_HP_OUT_CTL_1, &out) ||
+	    regmap_read(cs43130->regmap, CS43130_CLASS_H_CTL, &class_h))
+		return Y2_HP_LEVELS;
+	for (i = 0; i < Y2_HP_LEVELS; i++)
+		if ((out & Y2_HP_OUT_FS_MASK) == y2_hp_out_fs[i] &&
+		    (class_h & Y2_CLASS_H_HV_EN) == y2_hp_hv_en[i])
+			return i;
+	return Y2_HP_LEVELS;
+}
