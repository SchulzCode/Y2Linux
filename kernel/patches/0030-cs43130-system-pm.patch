+static int cs43130_restore_cache(struct cs43130_private *cs43130)
+{
+	int ret;
+
+	cs43130_pm_note("cs_access_begin", 0);
+	regcache_cache_only(cs43130->regmap, false);
+	gpiod_set_value_cansleep(cs43130->reset_gpio, 1);
+	cs43130_pm_note("cs_delay_begin", 0);
+	usleep_range(2000, 2050);
+	cs43130_pm_note("cs_delay_done", 0);
+
+	cs43130_pm_note("cs_cache_begin", 0);
+	ret = regcache_sync(cs43130->regmap);
+	cs43130_pm_note("cs_cache_done", ret);
+	if (ret)
+		return ret;
+
+	if (cs43130->xtal_ibias != CS43130_XTAL_UNUSED) {
+		cs43130_pm_note("cs_xtal_begin", 0);
+		ret = regmap_update_bits(cs43130->regmap, CS43130_INT_MASK_1,
+					 CS43130_XTAL_ERR_INT, 0);
+		cs43130_pm_note("cs_xtal_done", ret);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
