+static ssize_t hpload_measure_store(struct device *dev,
+				    struct device_attribute *attr,
+				    const char *buf, size_t count)
+{
+	struct cs43130_private *cs43130 = dev_get_drvdata(dev);
+	struct snd_soc_card *card;
+	unsigned int status = 0;
+	int ret;
+
+	if (!cs43130->component || !cs43130->mclk)
+		return -ENODEV;
+	mutex_lock(&y2_hp_lock);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		goto unlock;
+	/* Held for the whole measurement: no stream powers the amplifier while
+	 * imp_meas and the level below write HP_OUT_CTL_1. */
+	card = y2_hp_dapm_lock(cs43130);
+	mutex_lock(&cs43130->clk_mutex);
+	/* A stream owns the clocks, or one is open and may start any moment. */
+	ret = cs43130->clk_req || snd_soc_component_active(cs43130->component) ?
+		-EBUSY : 0;
+	mutex_unlock(&cs43130->clk_mutex);
+	if (!ret) {
