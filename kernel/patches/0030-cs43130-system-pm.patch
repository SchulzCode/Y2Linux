+		} else {
+			cs43130_imp_meas(&cs43130->work);
+			/* imp_meas wrote its load-based hv_seq; PDN_HP is set. */
+			mutex_lock(&y2_hp_level_lock);
+			y2_hp_level_write(cs43130);
+			mutex_unlock(&y2_hp_level_lock);
