 	.mutex_sof_reg = MT2701_MUTEX0_SOF0,
 };
 
+static const struct mtk_mutex_data mt6582_mutex_driver_data = {
+	.mutex_mod = mt2701_mutex_mod,
+	.mutex_sof = mt2712_mutex_sof,
+	.mutex_mod_reg = MT2701_MUTEX0_MOD0,
+	.mutex_sof_reg = MT2701_MUTEX0_SOF0,
+};
+
+
 static const struct mtk_mutex_data mt2712_mutex_driver_data = {
 	.mutex_mod = mt2712_mutex_mod,
 	.mutex_sof = mt2712_mutex_sof,
@@ -875,7 +883,21 @@
 {
 	struct mtk_mutex_ctx *mtx = container_of(mutex, struct mtk_mutex_ctx,
 						 mutex[mutex->id]);
-	return clk_prepare_enable(mtx->clk);
+    int ret = clk_prepare_enable(mtx->clk);
+    if (!ret && mtx->data == &mt6582_mutex_driver_data) {
+        /* Y2 DSI has parked LK before DRM binds. Replace inherited membership
+         * rather than ORing Linux's route into stale BLS/WDMA/RDMA bits. */
+        dev_info(mtx->dev, "Y2SCAN inherited mutex%u en=%08x get=%08x mod=%08x sof=%08x; clear parked ownership\n",
+            mutex->id, readl(mtx->regs+DISP_REG_MUTEX_EN(mutex->id)),
+            readl(mtx->regs+DISP_REG_MUTEX(mutex->id)),
+            readl(mtx->regs+MT2701_MUTEX0_MOD0+0x20*mutex->id),
+            readl(mtx->regs+MT2701_MUTEX0_SOF0+0x20*mutex->id));
+        writel(0, mtx->regs+DISP_REG_MUTEX_EN(mutex->id));
+        writel(0, mtx->regs+DISP_REG_MUTEX(mutex->id));
+        writel(0, mtx->regs+MT2701_MUTEX0_MOD0+0x20*mutex->id);
+        writel(0, mtx->regs+MT2701_MUTEX0_SOF0+0x20*mutex->id);
+    }
+    return ret;
 }
 EXPORT_SYMBOL_GPL(mtk_mutex_prepare);
 
