+
+static int mt6582_reg_read(void *context, unsigned int reg, void *val, size_t bytes)
+{
+	struct mtk_efuse_priv *priv = context;
+
+	/* MT6582's efuse bus exposes 32-bit words. Byte reads at the upper
+	 * three lanes return zero on Y2, silently truncating thermal fuses. */
+	if ((reg | bytes) & 3)
+		return -EINVAL;
+	while (bytes) {
+		put_unaligned_le32(readl(priv->base + reg), val);
+		val += 4;
+		reg += 4;
+		bytes -= 4;
+	}
 	return 0;
 }
 
