+static int mtk_pmic_keys_resume(struct device *dev)
+{
+	struct mtk_pmic_keys *keys = dev_get_drvdata(dev);
+	int i, ret, first = 0;
+	for (i = 0; i < MTK_PMIC_MAX_KEY_COUNT; i++) {
+		struct mtk_pmic_keys_info *k = &keys->keys[i];
+		if (k->wake_armed) {
+			ret = disable_irq_wake(k->irq);
+			if (ret && !first) first = ret;
+			if (!ret) k->wake_armed = false;
+		}
+		if (k->wake_r_armed) {
+			ret = disable_irq_wake(k->irq_r);
+			if (ret && !first) first = ret;
+			if (!ret) k->wake_r_armed = false;
+		}
+	}
+	return first;
+}
