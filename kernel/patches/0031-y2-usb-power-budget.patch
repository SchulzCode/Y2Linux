 };
 
+#ifdef CONFIG_Y2_POWER
+static bool cdc_registered;
+static int cdc_normal_boot(struct notifier_block *nb, unsigned long event, void *data)
+{
+	int ret;
+	/* Process context, before rescue switch_root. MUSB remains the same
+	 * provider; USB core disconnects, drops the old budget, and rebinds the
+	 * normal composite. The charger keeps its elapsed-time/fault state. */
+	if (cdc_registered && !cdc_offline)
+		return NOTIFY_OK;
+	if (cdc_registered) {
+		usb_composite_unregister(&cdc_driver);
+		cdc_registered = false;
+	}
+	ret = usb_composite_probe(&cdc_driver);
+	if (!ret)
+		cdc_registered = true;
+	return notifier_from_errno(ret);
+}
+static struct notifier_block cdc_boot_notifier = { .notifier_call = cdc_normal_boot };
+static int __init cdc_init(void)
+{
+	int ret;
+	cdc_offline = !y2_normal_boot_enabled();
+	ret = usb_composite_probe(&cdc_driver);
+	if (ret)
+		return ret;
+	cdc_registered = true;
+	ret = y2_boot_register_notifier(&cdc_boot_notifier);
+	if (ret) {
+		usb_composite_unregister(&cdc_driver);
+		cdc_registered = false;
+	}
+	return ret;
+}
+static void __exit cdc_exit(void)
+{
+	y2_boot_unregister_notifier(&cdc_boot_notifier);
+	if (cdc_registered)
+		usb_composite_unregister(&cdc_driver);
+}
+module_init(cdc_init);
+module_exit(cdc_exit);
+#else
 module_usb_composite_driver(cdc_driver);
+#endif
 
 MODULE_DESCRIPTION(DRIVER_DESC);
 MODULE_AUTHOR("David Brownell");
