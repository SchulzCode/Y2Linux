+/* 1 while the line is held in reset (its bit is cleared by assert), else 0.
+ * Without .status, reset_control_status() returned -ENOTSUPP and the Y2 panel
+ * driver could never adopt the panel LK left lit (Y2Linux #45). */
+static int mtk_mmsys_reset_status(struct reset_controller_dev *rcdev, unsigned long id)
+{
+	struct mtk_mmsys *mmsys = container_of(rcdev, struct mtk_mmsys, rcdev);
+	u32 reg;
+
+	if (mmsys->data->rst_tb) {
+		if (id >= mmsys->data->num_resets)
+			return -EINVAL;
+		id = mmsys->data->rst_tb[id];
+	}
+	reg = mmsys->data->sw0_rst_offset + (id / MMSYS_SW_RESET_PER_REG) * sizeof(u32);
+	return !(readl_relaxed(mmsys->regs + reg) & BIT(id % MMSYS_SW_RESET_PER_REG));
+}
+
 static const struct reset_control_ops mtk_mmsys_reset_ops = {
 	.assert = mtk_mmsys_reset_assert,
 	.deassert = mtk_mmsys_reset_deassert,
 	.reset = mtk_mmsys_reset,
+	.status = mtk_mmsys_reset_status,
 };
 
