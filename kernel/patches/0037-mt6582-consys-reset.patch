+#if IS_ENABLED(CONFIG_Y2_POWER)
+#include "/project/kernel/platform/pm-journal.h"
+/* F56: the RGU runs (31 s) from probe on and the core's watchdogd feeds it
+ * every 15.5 s while no one has /dev/watchdog open, so a hard freeze (no
+ * interrupts, no scheduling) ends in a warm reset that keeps pstore instead
+ * of a dead player. An opener (power.py shutdown, the recovery keeper) feeds
+ * it alone; the core never pings while it is open. mtk_wdt.y2_keepalive=0
+ * on the command line keeps the stopped watchdog of earlier releases. */
+static bool y2_keepalive = true;
+module_param(y2_keepalive, bool, 0444);
+MODULE_PARM_DESC(y2_keepalive, "Y2: kernel-fed watchdog from probe (default=1)");
+static struct mtk_wdt_dev *y2_keepalive_wdt;
+/* Y2 suspend/dormant backstop. The RGU counts only while a staged PM
+ * request is in flight (or a full request outside SPM); expiry is the same
+ * RGU reset as Linux reboot and preserves the retained PM journal. It is
+ * refused while userspace owns /dev/watchdog and is invisible to the
+ * watchdog core, so suspend/resume never start or stop it implicitly.
+ * While it runs it owns the RGU: watchdogd's pings would hide the stall. */
+static struct mtk_wdt_dev *y2_backstop;
+static bool y2_backstop_owns;
+static bool y2_keepalive_running(struct watchdog_device *wdd)
+{
+	return y2_keepalive_wdt && wdd == &y2_keepalive_wdt->wdt_dev &&
+		watchdog_hw_running(wdd) && !READ_ONCE(y2_backstop_owns);
+}
+static int y2_backstop_start(unsigned int seconds)
+{
+	struct watchdog_device *wdd = &y2_backstop->wdt_dev;
+	unsigned int saved = wdd->timeout;
+	int ret;
+
+	if (watchdog_active(wdd) || seconds < WDT_MIN_TIMEOUT || seconds > WDT_MAX_TIMEOUT)
+		return -EBUSY;
+	WRITE_ONCE(y2_backstop_owns, true);
+	wdd->timeout = seconds;
+	ret = mtk_wdt_start(wdd);
+	wdd->timeout = saved;
+	if (!ret)
+		ret = mtk_wdt_ping(wdd);
+	if (ret)
+		WRITE_ONCE(y2_backstop_owns, false);
+	return ret;
+}
+static void y2_backstop_ping(void)
+{
+	mtk_wdt_ping(&y2_backstop->wdt_dev);
+}
+static void y2_backstop_stop(void)
+{
+	if (!watchdog_active(&y2_backstop->wdt_dev))
+		mtk_wdt_stop(&y2_backstop->wdt_dev);
+}
+/* The backstop is over (suspend exit, dormant end, also after a failed
+ * restart): the kernel-fed watchdog takes the RGU back at its own timeout. */
+static void y2_backstop_end(void)
+{
+	struct watchdog_device *wdd = &y2_backstop->wdt_dev;
+
+	WRITE_ONCE(y2_backstop_owns, false);
+	if (y2_keepalive_running(wdd)) {
+		mtk_wdt_start(wdd);
+		mtk_wdt_ping(wdd);
+	}
+}
+static const struct y2_pm_backstop_ops y2_backstop_ops = {
+	.start = y2_backstop_start, .ping = y2_backstop_ping, .stop = y2_backstop_stop,
+	.end = y2_backstop_end,
+};
+#else
+static bool y2_keepalive_running(struct watchdog_device *wdd)
+{
+	return false;
+}
+#endif
