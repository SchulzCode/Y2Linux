+#if IS_ENABLED(CONFIG_Y2_POWER)
+#include "/project/kernel/platform/pm-journal.h"
+/* Y2 owner-qualification backstop. The RGU counts only while a staged PM
+ * request is in flight (or a full request outside SPM); expiry is the same
+ * RGU reset as Linux reboot and preserves the retained PM journal. It is
+ * refused while userspace owns /dev/watchdog and is invisible to the
+ * watchdog core, so suspend/resume never start or stop it implicitly. */
+static struct mtk_wdt_dev *y2_backstop;
+static int y2_backstop_start(unsigned int seconds)
+{
+	struct watchdog_device *wdd = &y2_backstop->wdt_dev;
+	unsigned int saved = wdd->timeout;
+	int ret;
+
+	if (watchdog_active(wdd) || seconds < WDT_MIN_TIMEOUT || seconds > WDT_MAX_TIMEOUT)
+		return -EBUSY;
+	wdd->timeout = seconds;
+	ret = mtk_wdt_start(wdd);
+	wdd->timeout = saved;
+	if (!ret)
+		ret = mtk_wdt_ping(wdd);
+	return ret;
+}
+static void y2_backstop_ping(void)
+{
+	mtk_wdt_ping(&y2_backstop->wdt_dev);
+}
+static void y2_backstop_stop(void)
+{
+	if (!watchdog_active(&y2_backstop->wdt_dev))
+		mtk_wdt_stop(&y2_backstop->wdt_dev);
+}
+static const struct y2_pm_backstop_ops y2_backstop_ops = {
+	.start = y2_backstop_start, .ping = y2_backstop_ping, .stop = y2_backstop_stop,
+};
+#endif
