+#if IS_ENABLED(CONFIG_Y2_POWER)
+/* watchdogd's and userspace's ping; the backstop pings mtk_wdt_ping itself. */
+static int y2_wdt_ping(struct watchdog_device *wdd)
+{
+	if (READ_ONCE(y2_backstop_owns))
+		return 0;
+	return mtk_wdt_ping(wdd);
+}
+/* A magic close ('V', the recovery keeper) or WDIOS_DISABLECARD reaches stop
+ * with WDOG_HW_RUNNING already cleared by the core: the RGU keeps counting
+ * and watchdogd feeds it again. The core's reboot notifier (reboot(2),
+ * power-off) calls stop with the bit set: that really stops it, as power.py
+ * and the F50 power-off handlers expect. */
+static int y2_wdt_stop(struct watchdog_device *wdd)
+{
+	if (!test_and_clear_bit(WDOG_HW_RUNNING, &wdd->status)) {
+		set_bit(WDOG_HW_RUNNING, &wdd->status);
+		return 0;
+	}
+	return mtk_wdt_stop(wdd);
+}
+static const struct watchdog_ops y2_wdt_ops = {
+	.owner		= THIS_MODULE,
+	.start		= mtk_wdt_start,
+	.stop		= y2_wdt_stop,
+	.ping		= y2_wdt_ping,
+	.set_timeout	= mtk_wdt_set_timeout,
+	.set_pretimeout	= mtk_wdt_set_pretimeout,
+	.restart	= mtk_wdt_restart,
+};
+static void y2_keepalive_arm(struct mtk_wdt_dev *mtk_wdt)
+{
+	void __iomem *wdt_base = mtk_wdt->wdt_base;
+
+	/* Stock normal mode (FM mtk_wdt_probe): reset the PMIC too and restart
+	 * past the Power key, so LK boots normally (boot_reason 4). Only
+	 * BAT0/watchdog_powers_off, for a power-off, clears the restart bit. */
+	writel(readl(wdt_base + WDT_MODE) | WDT_MODE_EXRST_EN | WDT_MODE_AUTO_START |
+	       WDT_MODE_KEY, wdt_base + WDT_MODE);
+	mtk_wdt->wdt_dev.ops = &y2_wdt_ops;
+	mtk_wdt_start(&mtk_wdt->wdt_dev);
+	/* Registered running: the core feeds it until /dev/watchdog is opened
+	 * (CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED, no open deadline). */
+	set_bit(WDOG_HW_RUNNING, &mtk_wdt->wdt_dev.status);
+	y2_keepalive_wdt = mtk_wdt;
+}
