    "wpa_cli",
    "-i",
    "wlan0",
    "status"
   ],
   "timeout": 3.0
  },
  {
   "argv": [
    "ip",
    "-j",
    "-4",
    "addr",
    "show",
    "dev",
    "wlan0"
   ],
   "timeout": 1.0
  },
  {
   "argv": [
    "ip",
    "-j",
    "-4",
    "route",
    "show",
    "default",
    "dev",
    "wlan0"
   ],
   "timeout": 1.0
  },
  {
   "argv": [
    "wpa_cli",
    "-i",
    "wlan0",
    "signal_poll"
   ],
   "timeout": 3.0
  },
  {
   "argv": [
    "/usr/sbin/y2-bt-observe"
   ],
   "timeout": 3.0
  },
  {
   "argv": [
    "/sbin/ip",
    "-4",
    "-o",
    "addr",
    "show",
    "dev",
    "usb0"
   ],
