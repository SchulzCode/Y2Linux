#!/bin/busybox sh
# Rescue PID1: only the removable native SD host can supply Y2ROOT.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp /newroot /sys/kernel/debug
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t debugfs debugfs /sys/kernel/debug
[ -e /dev/y2diag ] || mknod -m 600 /dev/y2diag c 120 0
/sbin/y2-observer &
observer=$!
(sleep 8; /sbin/y2-fbtest > /dev/kmsg 2>&1) &
echo 'Y2ROOT: rescue active; searching removable SD LABEL=Y2ROOT' > /dev/kmsg
# Give asynchronous display and SD discovery time while ACM remains live.
sleep 20
rootdev=
ambiguous=0
for entry in /sys/class/block/*; do
    path=$(readlink -f "$entry")
    case "$path" in */11240000.mmc/*) ;; *) continue;; esac
    dev=/dev/${entry##*/}
    info=$(blkid "$dev" 2>/dev/null) || continue
    case "$info" in *'LABEL="Y2ROOT"'*) ;; *) continue;; esac
    case "$info" in *'TYPE="ext4"'*) ;; *) continue;; esac
    if [ -n "$rootdev" ]; then ambiguous=1; break; fi
    rootdev=$dev
done
if [ "$ambiguous" = 0 ] && [ -n "$rootdev" ] && mount -t ext4 -o ro "$rootdev" /newroot; then
    if [ -x /newroot/sbin/init ] && [ -x /newroot/usr/sbin/y2-observer ] &&
       [ -r /newroot/etc/y2linux/build-id ] && chroot /newroot /bin/true &&
       mount -o remount,rw /newroot; then
        echo "Y2ROOT: verified $rootdev; switching to Buildroot" > /dev/kmsg
        kill "$observer"
        wait "$observer" 2>/dev/null
        moved=
        move_ok=1
        for fs in proc sys run tmp dev; do
            mkdir -p "/newroot/$fs"
            if mount --move "/$fs" "/newroot/$fs"; then
                moved="$fs $moved"
            else
                move_ok=0
                break
            fi
        done
        if [ "$move_ok" = 1 ]; then
            exec switch_root -c /dev/console /newroot /sbin/init
        fi
        for fs in $moved; do mount --move "/newroot/$fs" "/$fs"; done
        /sbin/y2-observer &
        observer=$!
    fi
    umount /newroot
fi
echo 'Y2ROOT: missing, ambiguous or unusable; remaining in rescue with persistent ACM' > /dev/kmsg
# No automatic reboot and no guessed alternate disk. Serial rescue shell only;
# ttyGS0 has a single writer, the LOG1 observer.
while :; do
    /bin/busybox sh </dev/console >/dev/console 2>&1
    sleep 1
done
